rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedInUser(userId) {
      return request.auth != null && request.auth.uid == userId
        && !exists(/databases/$(database)/documents/accountDeletionLocks/$(userId));
    }

    // Cada cuenta solo puede acceder a sus datos. El estado de plan bajo
    // account/ se administra exclusivamente con Firebase Admin SDK.
    // El comodín recursivo es una ruta, no un string: no admite matches().
    match /artifacts/mientrenador-v3/users/{userId}/{collection}/{document=**} {
      allow read, write: if isSignedInUser(userId)
        && collection != 'account';
    }
    match /artifacts/mientrenador-v3/users/{userId}/account/{accountDocument=**} {
      allow read: if isSignedInUser(userId);
      allow write: if false;
    }

    // Cualquier otra ruta queda cerrada por defecto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
