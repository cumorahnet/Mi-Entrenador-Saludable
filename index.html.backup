<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#020617">
    <title>Mi Entrenador Saludable</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
    <script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- Leaflet CSS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoCcT9Q5Ry0tCOiLw86eKtrLPMAd+Cpsff/2cTTz" crossorigin=""/>
    <!-- Leaflet JS -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/4K8VMYdg36+L9VOh3HnRy/B9gPbhzgzHV328+mabAqP" crossorigin=""></script>
    <!-- html2canvas for saving map as image -->
    <script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js"></script>

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&display=swap');
        body {
            font-family: 'Inter', sans-serif; background-color: #020617; color: white;
            margin: 0; padding: 0; overflow: hidden; -webkit-tap-highlight-color: transparent;
            position: fixed; width: 100%; height: 100%;
        }
        #root { height: 100%; width: 100%; display: flex; flex-direction: column; }
        .glass-card {
            background: rgba(255,255,255,0.03); backdrop-filter: blur(10px);
            border: 1px solid rgba(255,255,255,0.05); border-radius: 1.5rem;
        }
        .scrollbar-hide::-webkit-scrollbar { display: none; }
        .timer-huge {
            font-size: 60vw; line-height: 0.75; font-weight: 900;
            letter-spacing: -0.06em; pointer-events: none;
        }
        @media (orientation: landscape) { .timer-huge { font-size: 75vh; } }
        .leaflet-container {
            width: 100%;
            height: 100%;
            border-radius: 1.5rem;
        }
    </style>
</head>
<body>
    <div id="root"></div>

    <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-auth-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-firestore-compat.js"></script>

    <script>
        // Global error handler for uncaught JavaScript errors
        window.onerror = function(message, source, lineno, colno, error) {
            console.error('GLOBAL JS ERROR:', { message, source, lineno, colno, error });
            alert('Ha ocurrido un error inesperado en la aplicación. Por favor, revisa la consola para más detalles.');
            return true;
        };

        const { useState, useEffect, useRef, useCallback, useMemo } = React;

        const IconPlay = () => React.createElement('svg', { width: "40", height: "40", viewBox: "0 0 24 24", fill: "currentColor" }, React.createElement('path', { d: "M8 5v14l11-7z" }));
        const IconPause = () => React.createElement('svg', { width: "24", height: "24", viewBox: "0 0 24 24", fill: "currentColor" }, React.createElement('path', { d: "M6 19h4V5H6v14zm8-14v14h4V5h-4z" }));
        const IconShare = () => React.createElement('svg', { width: "24", height: "24", viewBox: "0 0 24 24", fill: "currentColor" }, React.createElement('path', { d: "M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.52.47 1.2.77 1.96.77 1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3c0 .24.04.47.09.7L7.94 12.03c-.52-.47-1.2-.77-1.96-.77-1.66 0-3 1.34-3 3s1.34 3 3 3c.76 0 1.44-.3 1.96-.77l7.05 4.11c-.05.23-.09.46-.09.7 0 1.66 1.34 3 3 3s3-1.34 3-3-1.34-3-3-3z" }));
        const IconSave = () => React.createElement('svg', { width: "24", height: "24", viewBox: "0 0 24 24", fill: "currentColor" }, React.createElement('path', { d: "M17 3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V7l-4-4zm-5 16c-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3-1.34 3-3 3zm3-10H5V5h10v4z" }));

        const firebaseConfig = {
            apiKey: "AIzaSyDg0nohFAprIYta3Z3IvFGms55PehyxGIM",
            authDomain: "entrenadorpersonal-4e69d.firebaseapp.com",
            projectId: "entrenadorpersonal-4e69d",
            storageBucket: "entrenadorpersonal-4e69d.firebasestorage.app",
            messagingSenderId: "198872357236",
            appId: "1:198872357236:web:c3cd2a7f5caff197847421"
        };
        
        if (!firebase.apps.length) firebase.initializeApp(firebaseConfig);
        const auth = firebase.auth();
        const db = firebase.firestore();

        const APP_ID = "mientrenador-v3";
        const APP_TITLE = "Mi Entrenador Saludable";
        const APP_VERSION = "1.0.5";

        const WARMUP_STEPS = [
            { label: 'TOBILLO DERECHO', voice: 'Tobillo derecho' },
            { label: 'TOBILLO IZQUIERDO', voice: 'Tobillo izquierdo' },
            { label: 'RODILLAS DERECHA', voice: 'Rodillas a la derecha' },
            { label: 'RODILLAS IZQUIERDA', voice: 'Rodillas a la izquierda' },
            { label: 'CINTURA DERECHA', voice: 'Cintura a la derecha' },
            { label: 'CINTURA IZQUIERDA', voice: 'Cintura a la izquierda' },
            { label: 'BRAZO DERECHO', voice: 'Brazo derecho' },
            { label: 'BRAZO IZQUIERDO', voice: 'Brazo izquierdo' },
            { label: 'CUELLO ADELANTE Y ATRÁS', voice: 'Cuello adelante y atrás' },
            { label: 'CUELLO DER. E IZQ.', voice: 'Cuello derecha e izquierda' },
        ];

        const TRAINING_ZONES = ['PIERNAS', 'BRAZOS', 'TRONCO'];
        const DEFAULT_PARAMS = {
            entrenamiento: {
                action: 30, change: 5, rounds: 3, cycles: 4, rest: 60, zoneRest: 30,
                stretchSteps: 16, stretchAction: 30, stretchChange: 10
            }
        };
        const formatTime = (s) => `${Math.floor(s / 60)}:${(s % 60).toString().padStart(2, '0')}`;

        const GPS_PHASE_KEY = 'gps-tracking';
        const POST_GPS_REST_PHASE_KEY = 'post-gps-rest';

        const getDistance = (lat1, lon1, lat2, lon2) => {
            const R = 6371e3;
            const φ1 = lat1 * Math.PI/180;
            const φ2 = lat2 * Math.PI/180;
            const Δφ = (lat2-lat1) * Math.PI/180;
            const Δλ = (lon2-lon1) * Math.PI/180;

            const a = Math.sin(Δφ/2) * Math.sin(Δφ/2) +
                      Math.cos(φ1) * Math.cos(φ2) *
                      Math.sin(Δλ/2) * Math.sin(Δλ/2);
            const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));

            return R * c;
        };

        const formatPace = (totalDistanceMeters, totalTimeSeconds) => {
            if (totalDistanceMeters <= 0 || totalTimeSeconds <= 0) return '0:00';
            const paceSecondsPerKm = (totalTimeSeconds / (totalDistanceMeters / 1000));
            const minutes = Math.floor(paceSecondsPerKm / 60);
            const seconds = Math.round(paceSecondsPerKm % 60);
            return `${minutes}:${seconds.toString().padStart(2, '0')}`;
        };

        const formatDistance = (meters) => {
            if (meters < 1000) return `${Math.round(meters)} m`;
            return `${(meters / 1000).toFixed(2)} km`;
        };

        const formatSpeed = (meters, seconds) => {
            if (meters <= 0 || seconds <= 0) return '0.0 km/h';
            const kmPerHour = (meters / 1000) / (seconds / 3600);
            return `${kmPerHour.toFixed(1)} km/h`;
        };

        const whistle = () => {
            try {
                const ctx = new (window.AudioContext || window.webkitAudioContext)();
                const now = ctx.currentTime;
                const duration = 1.6;
                const createOsc = (freq, type = 'sine', vol = 1.0) => {
                    const osc = ctx.createOscillator();
                    const gain = ctx.createGain();
                    const mod = ctx.createOscillator();
                    const modGain = ctx.createGain();
                    osc.type = type;
                    osc.frequency.setValueAtTime(freq, now);
                    mod.frequency.setValueAtTime(45, now);
                    modGain.gain.setValueAtTime(freq * 0.1, now);
                    mod.connect(modGain); modGain.connect(osc.frequency);
                    osc.connect(gain); gain.connect(ctx.destination);
                    gain.gain.setValueAtTime(0, now);
                    gain.gain.linearRampToValueAtTime(vol, now + 0.05);
                    gain.gain.exponentialRampToValueAtTime(0.01, now + duration);
                    osc.start(now); mod.start(now);
                    osc.stop(now + duration); mod.stop(now + duration);
                };
                createOsc(3500); createOsc(3515, 'triangle', 0.5);
            } catch (e) { console.warn("Whistle failed:", e); }
        };

        const voiceQueue = [];
        let voiceBusy = false;
        const flushVoice = () => {
            if (voiceBusy || voiceQueue.length === 0 || !window.speechSynthesis) return;
            voiceBusy = true;
            const item = voiceQueue.shift();
            const text = typeof item === 'string' ? item : item.text;
            const onEndCallback = typeof item === 'object' && item.onEnd ? item.onEnd : () => {};
            const msg = new SpeechSynthesisUtterance(text);
            msg.lang = 'es-ES'; msg.rate = 1.05;
            msg.onend = msg.onerror = () => { voiceBusy = false; onEndCallback(); flushVoice(); };
            window.speechSynthesis.speak(msg);
        };
        const speak = (text, interrupt = false, onEnd = null) => {
            if (!window.speechSynthesis) {
                console.warn("SpeechSynthesis not available.");
                if (onEnd) onEnd();
                return;
            }
            if (interrupt) { window.speechSynthesis.cancel(); voiceQueue.length = 0; voiceBusy = false; }
            if (text) voiceQueue.push(onEnd ? { text, onEnd } : text);
            flushVoice();
        };

        const startOfDay = (date) => { const d = new Date(date); d.setHours(0, 0, 0, 0); return d; };
        const endOfDay = (date) => { const d = new Date(date); d.setHours(23, 59, 59, 999); return d; };
        const getWeekRange = (date, offset = 0) => {
            const d = startOfDay(new Date(date));
            d.setDate(d.getDate() + offset * 7);
            const day = d.getDay();
            const diff = d.getDate() - day + (day === 0 ? -6 : 1);
            const start = startOfDay(new Date(d.setDate(diff)));
            const end = endOfDay(new Date(d.setDate(diff + 6)));
            return { start, end };
        };
        const getMonthRange = (date, offset = 0) => {
            const d = startOfDay(new Date(date));
            d.setMonth(d.getMonth() + offset);
            const start = startOfDay(new Date(d.getFullYear(), d.getMonth(), 1));
            const end = endOfDay(new Date(d.getFullYear(), d.getMonth() + 1, 0));
            return { start, end };
        };
        const getYearRange = (date, offset = 0) => {
            const d = startOfDay(new Date(date));
            d.setFullYear(d.getFullYear() + offset);
            const start = startOfDay(new Date(d.getFullYear(), 0, 1));
            const end = endOfDay(new Date(d.getFullYear(), 11, 31));
            return { start, end };
        };

        const generateWarmupSegment = (ent, nextPhaseIntro = null) => {
            const s = [];
            s.push({ label: 'PREPÁRATE', seconds: 15, color: 'bg-yellow-400', phase: 'inicio', voiceInitial: 'Prepárate para el calentamiento', whistleOnStart: false, voiceCountdown: true });
            WARMUP_STEPS.forEach((ws, i) => {
                s.push({ label: ws.label, seconds: 30, color: 'bg-yellow-400', phase: 'calentamiento', voiceInitial: ws.voice || ws.label.toLowerCase(), whistleOnStart: true, voiceCountdown: true });
                if (i < WARMUP_STEPS.length - 1) {
                    s.push({ label: 'CAMBIO', seconds: 5, color: 'bg-yellow-300', phase: 'cambio-warmup', voiceInitial: 'Cambio', voiceMidpoint: { time: 2, text: WARMUP_STEPS[i + 1].voice }, whistleOnStart: false, voiceCountdown: true });
                }
            });
            const transitionVoice = nextPhaseIntro ? ` ${nextPhaseIntro}` : '';
            s.push({ label: 'DESCANSO', seconds: 20, color: 'bg-rose-400', phase: 'post-warmup', voiceInitial: `Descanso.${transitionVoice}`, whistleOnStart: false, voiceCountdown: true });
            return s;
        };

        const generateMainTrainingSegment = (ent, nextPhaseIntro = null) => {
            const s = [];
            for (let cy = 1; cy <= ent.cycles; cy++) {
                TRAINING_ZONES.forEach((zone, zi) => {
                    for (let r = 1; r <= ent.rounds; r++) {
                        s.push({ label: zone, seconds: ent.action, color: 'bg-emerald-400', phase: 'entrenamiento', r, tr: ent.rounds, cy, tc: ent.cycles, voiceInitial: zone.toLowerCase(), whistleOnStart: true, voiceCountdown: true });
                        if (r < ent.rounds) {
                            s.push({ label: 'CAMBIO', seconds: ent.change, color: 'bg-yellow-300', phase: 'cambio-ent', voiceInitial: 'Cambio', voiceMidpoint: { time: 2, text: `Siguiente: ${zone.toLowerCase()}` }, whistleOnStart: false, voiceCountdown: true });
                        }
                    }
                    if (zi < TRAINING_ZONES.length - 1) {
                        s.push({ label: 'DESCANSO', seconds: ent.zoneRest, color: 'bg-sky-500', phase: 'zone-rest', voiceInitial: 'Descanso de zona', voiceMidpoint: { time: 10, text: `Siguiente zona: ${TRAINING_ZONES[zi + 1].toLowerCase()}` }, whistleOnStart: false, voiceCountdown: true });
                    }
                });
                if (cy < ent.cycles) {
                    s.push({ label: 'DESCANSO', seconds: ent.rest, color: 'bg-rose-500', phase: 'ciclo-rest', voiceInitial: `Descanso de ciclo. Queda ${ent.cycles - cy} ${ent.cycles - cy === 1 ? 'ciclo' : 'ciclos'}`, voiceMidpoint: { time: 10, text: 'Nuevo ciclo. Piernas.' }, whistleOnStart: false, voiceCountdown: true });
                }
            }
            const transitionVoice = nextPhaseIntro ? ` ${nextPhaseIntro}` : '';
            s.push({ label: 'DESCANSO', seconds: 30, color: 'bg-rose-400', phase: 'post-training', voiceInitial: `Descanso.${transitionVoice}`, whistleOnStart: false, voiceCountdown: true });
            return s;
        };

        const generateGpsRunSegment = (activityTypeLabel, nextPhaseIntro = null) => {
            const s = [];
            const initialVoice = `Comienza ${activityTypeLabel.toLowerCase()}. Tres, dos, uno.`;
            s.push({
                label: `INICIAR ${activityTypeLabel.toUpperCase()}`,
                seconds: 4, // This duration is for the initial voice countdown, then GPS tracking starts indefinitely
                color: 'bg-gray-800',
                phase: GPS_PHASE_KEY,
                voiceInitial: initialVoice,
                whistleOnStart: true,
                voiceCountdown: true
            });
            // The actual GPS tracking will be an indefinite "step" within the 'gps-running' UI status
            // The post-GPS rest phase will be triggered manually after user ends tracking.
            const transitionVoice = nextPhaseIntro ? ` ${nextPhaseIntro}` : '';
            s.push({ label: 'DESCANSO (POST-GPS)', seconds: 10, color: 'bg-teal-400', phase: POST_GPS_REST_PHASE_KEY, voiceInitial: `Descanso.${transitionVoice}`, whistleOnStart: false, voiceCountdown: true });
            return s;
        };

        const generateStretchSegment = (ent, nextPhaseIntro = null) => {
            const s = [];
            s.push({ label: 'DESCANSO', seconds: 30, color: 'bg-blue-200', phase: 'pre-stretches', voiceInitial: 'Descanso. Prepárate para los estiramientos', whistleOnStart: false, voiceCountdown: true });
            for (let i = 0; i < ent.stretchSteps; i++) {
                s.push({ label: `ESTIRAMIENTO ${i + 1}`, seconds: ent.stretchAction, color: 'bg-blue-400', phase: 'estiramientos', voiceInitial: `Estiramiento ${i + 1}`, whistleOnStart: true, voiceCountdown: true });
                if (i < ent.stretchSteps - 1) {
                    s.push({ label: 'CAMBIO', seconds: ent.stretchChange, color: 'bg-blue-200', phase: 'cambio-est', voiceInitial: 'Cambio', voiceMidpoint: { time: 2, text: `Siguiente estiramiento` }, whistleOnStart: false, voiceCountdown: true });
                }
            }
            const lastStepOfStretch = s[s.length -1];
            if (lastStepOfStretch && nextPhaseIntro) {
                lastStepOfStretch.voiceInitial = `${lastStepOfStretch.voiceInitial}.${nextPhaseIntro}`;
            }
            return s;
        };

        const ALL_POSSIBLE_SEGMENTS_DATA = [
            { key: 'warmup', label: 'Calentamiento', generator: generateWarmupSegment },
            { key: 'training', label: 'Ejercicio Principal', generator: generateMainTrainingSegment },
            { key: 'walk', label: 'Caminata (GPS)', generator: generateGpsRunSegment },
            { key: 'run', label: 'Carrera (GPS)', generator: generateGpsRunSegment },
            { key: 'stretch', label: 'Estiramientos', generator: generateStretchSegment },
        ];
        const ALL_POSSIBLE_SEGMENTS_ORDERED_KEYS = ALL_POSSIBLE_SEGMENTS_DATA.map(s => s.key);

        const generateWorkoutSteps = (workout, defaultParams, selectedPhasesKeys) => {
            if (!selectedPhasesKeys || selectedPhasesKeys.length === 0) {
                console.warn('generateWorkoutSteps: No phases selected. Returning error step.');
                return [{ label: 'NO HAY FASES', seconds: 5, color: 'bg-red-500', phase: 'error', voiceInitial: 'No se seleccionó ninguna fase. Por favor, cancela.', whistleOnStart: false, voiceCountdown: false }];
            }
            if (!workout) {
                console.error('generateWorkoutSteps: Workout object is null. Returning error step.');
                 return [{ label: 'ERROR DE RUTINA', seconds: 5, color: 'bg-red-500', phase: 'error', voiceInitial: 'Error: Rutina no encontrada. Por favor, cancela.', whistleOnStart: false, voiceCountdown: false }];
            }

            const ent = { ...defaultParams.entrenamiento, ...(workout.phases?.entrenamiento || {}) };
            let steps = [];

            const activeSegments = ALL_POSSIBLE_SEGMENTS_DATA.filter(segment =>
                selectedPhasesKeys.includes(segment.key)
            ).sort((a, b) => ALL_POSSIBLE_SEGMENTS_ORDERED_KEYS.indexOf(a.key) - ALL_POSSIBLE_SEGMENTS_ORDERED_KEYS.indexOf(b.key));

            const firstActiveKey = activeSegments.length > 0 ? activeSegments[0].key : null;
            const isGpsFirst = (firstActiveKey === 'run' || firstActiveKey === 'walk');

            if (activeSegments.length > 0 && !isGpsFirst && firstActiveKey !== 'warmup') {
                let initialVoice = 'Prepárate para tu rutina.';
                if (firstActiveKey === 'training') initialVoice = 'Prepárate para el entrenamiento principal.';
                else if (firstActiveKey === 'stretch') initialVoice = 'Prepárate para los estiramientos.';
                steps.push({ label: 'PREPÁRATE', seconds: 15, color: 'bg-yellow-400', phase: 'inicio', voiceInitial: initialVoice, whistleOnStart: false, voiceCountdown: true });
            }

            for (let i = 0; i < activeSegments.length; i++) {
                const currentSegmentData = activeSegments[i];
                const nextSegmentData = activeSegments[i + 1];
                let introForNextInternalSegment = null;

                if (nextSegmentData) {
                    introForNextInternalSegment = `A continuación, ${nextSegmentData.label.toLowerCase()}.`;
                } else {
                    introForNextInternalSegment = 'Rutina finalizada.'; // Changed to avoid repeating "Buen trabajo"
                }

                if (currentSegmentData.key === 'run' || currentSegmentData.key === 'walk') {
                    steps = steps.concat(currentSegmentData.generator(currentSegmentData.label.split(' ')[0], introForNextInternalSegment));
                } else {
                    steps = steps.concat(currentSegmentData.generator(ent, introForNextInternalSegment));
                }
            }

            if (steps.length === 0) {
                console.error('generateWorkoutSteps: Steps array is empty after generation, adding generic error.');
                 return [{ label: 'ERROR DE GENERACIÓN', seconds: 5, color: 'bg-red-500', phase: 'error', voiceInitial: 'Error al generar los pasos de la rutina. Por favor, cancela.', whistleOnStart: false, voiceCountdown: false }];
            }

            // Modified voiceInitial to avoid repetition with the endWorkout function
            steps.push({ label: 'FINAL DE LA RUTINA', seconds: 10, color: 'bg-green-500', phase: 'finished', voiceInitial: 'Rutina finalizada.', whistleOnStart: false, voiceCountdown: false });
            console.log('generateWorkoutSteps: Successfully generated steps. Count:', steps.length);
            return steps;
        };

        function ModeSelectionScreen({ onModeSelected, onCancel }) {
            const [selectedPhases, setSelectedPhases] = useState([]);

            const togglePhase = (phaseKey) => {
                setSelectedPhases(prev =>
                    prev.includes(phaseKey)
                        ? prev.filter(key => key !== phaseKey)
                        : [...prev, phaseKey]
                );
            };

            const handleStart = () => {
                if (selectedPhases.length === 0) {
                    speak('Por favor, selecciona al menos una fase de entrenamiento.', true);
                    return;
                }
                console.log('ModeSelectionScreen: Phases selected. Starting workout with:', selectedPhases);
                onModeSelected(selectedPhases);
            };

            return React.createElement('div', { className: "h-screen flex flex-col items-center justify-center bg-slate-950 p-8 text-white text-center" },
                React.createElement('h1', { className: "text-4xl font-black italic mb-6 text-orange-500" }, "Configura tu Sesión"),
                React.createElement('p', { className: "text-sm text-slate-400 mb-8" }, "Elige las fases de entrenamiento que deseas realizar:"),
                React.createElement('div', { className: "flex flex-col space-y-4 w-full max-w-sm mb-10" },
                    ALL_POSSIBLE_SEGMENTS_DATA.map(phase =>
                        React.createElement('label', { key: phase.key, className: "flex items-center p-4 glass-card cursor-pointer" },
                            React.createElement('input', {
                                type: "checkbox",
                                checked: selectedPhases.includes(phase.key),
                                onChange: () => togglePhase(phase.key),
                                className: "form-checkbox h-5 w-5 text-orange-500 rounded border-gray-300 mr-4 focus:ring-orange-500"
                            }),
                            React.createElement('span', { className: "text-lg font-bold italic flex-1 text-left" }, phase.label)
                        )
                    )
                ),
                React.createElement('button', {
                    onClick: handleStart,
                    className: "w-full max-w-sm bg-orange-500 py-6 rounded-full font-black uppercase text-white active:scale-95 italic"
                }, "INICIAR ENTRENAMIENTO"),
                React.createElement('button', {
                    onClick: onCancel,
                    className: "mt-4 w-full max-w-sm bg-white/10 text-white py-4 rounded-full font-black uppercase active:scale-95 italic text-xs"
                }, "Cancelar")
            );
        }

        function GpsMapSummary({ gpsCoordinates, finalGpsSummary, onSave, onShare, onClose }) {
            const mapRef = useRef(null);
            const mapInstance = useRef(null);
            const mapContainerRef = useRef(null);

            useEffect(() => {
                if (!gpsCoordinates || gpsCoordinates.length === 0 || !mapRef.current) return;

                if (mapInstance.current) {
                    mapInstance.current.remove();
                }
                mapInstance.current = L.map(mapRef.current).setView([gpsCoordinates[0].lat, gpsCoordinates[0].lng], 13);

                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
                }).addTo(mapInstance.current);

                const latLngs = gpsCoordinates.map(coord => [coord.lat, coord.lng]);
                const polyline = L.polyline(latLngs, { color: '#f97316', weight: 5 }).addTo(mapInstance.current);
                mapInstance.current.fitBounds(polyline.getBounds());

                if (gpsCoordinates.length > 0) {
                    L.marker([gpsCoordinates[0].lat, gpsCoordinates[0].lng]).addTo(mapInstance.current)
                        .bindPopup('Inicio').openPopup();
                    if (gpsCoordinates.length > 1) {
                        const lastCoord = gpsCoordinates[gpsCoordinates.length - 1];
                        L.marker([lastCoord.lat, lastCoord.lng]).addTo(mapInstance.current)
                            .bindPopup('Fin').openPopup();
                    }
                }

                return () => {
                    if (mapInstance.current) {
                        mapInstance.current.remove();
                        mapInstance.current = null;
                    }
                };
            }, [gpsCoordinates]);

            const handleSave = useCallback(() => {
                if (!mapContainerRef.current) {
                    alert('Error: No se puede capturar el mapa.');
                    return;
                }
                html2canvas(mapContainerRef.current, { useCORS: true, logging: false }).then(canvas => {
                    const image = canvas.toDataURL('image/png');
                    const link = document.createElement('a');
                    link.href = image;
                    link.download = `ruta_entrenamiento_${new Date().toISOString().slice(0, 10)}.png`;
                    document.body.appendChild(link);
                    link.click();
                    document.body.removeChild(link);
                    speak('Mapa guardado.');
                }).catch(err => {
                    console.error('Error al guardar mapa:', err);
                    alert('No se pudo guardar el mapa. Inténtalo de nuevo.');
                });
            }, []);

            const handleShare = useCallback(() => {
                if (!mapContainerRef.current) {
                    alert('Error: No se puede compartir el mapa.');
                    return;
                }

                if (!navigator.share) {
                    alert('La función de compartir no está disponible en este navegador. Puedes guardar la imagen y compartirla manualmente.');
                    return;
                }

                html2canvas(mapContainerRef.current, { useCORS: true, logging: false }).then(async canvas => {
                    canvas.toBlob(async (blob) => {
                        if (!blob) {
                            alert('No se pudo generar la imagen para compartir.');
                            return;
                        }

                        const files = [new File([blob], `ruta_entrenamiento_${new Date().toISOString().slice(0, 10)}.png`, { type: 'image/png' })];
                        const shareData = {
                            title: 'Mi ruta de entrenamiento',
                            text: `¡Mira mi última actividad!\nDistancia: ${formatDistance(finalGpsSummary.distance)}\nTiempo: ${formatTime(finalGpsSummary.time)}\nRitmo: ${finalGpsSummary.pace} /km\nVelocidad media: ${formatSpeed(finalGpsSummary.distance, finalGpsSummary.time)}`,
                            files: files,
                        };

                        try {
                            await navigator.share(shareData);
                            speak('Mapa compartido con éxito.');
                        } catch (err) {
                            console.error('Error al compartir:', err);
                            if (err.name !== 'AbortError') {
                                alert('No se pudo compartir el mapa. Inténtalo de nuevo.');
                            }
                        }
                    }, 'image/png');
                }).catch(err => {
                    console.error('Error al generar imagen para compartir:', err);
                    alert('No se pudo compartir el mapa. Inténtalo de nuevo.');
                });
            }, [finalGpsSummary]);

            if (!finalGpsSummary) return null;

            return React.createElement('div', { className: "h-screen flex flex-col bg-slate-950 text-white p-6" },
                React.createElement('h2', { className: "text-3xl font-black italic text-orange-500 mb-4 text-center" }, "Tu Ruta GPS"),
                React.createElement('div', { className: "glass-card p-4 mb-4" },
                    React.createElement('div', { ref: mapContainerRef, className: "w-full h-64 rounded-xl overflow-hidden mb-4 relative" },
                        React.createElement('div', { ref: mapRef, className: "leaflet-container" })
                    ),
                    React.createElement('div', { className: "grid grid-cols-2 gap-4 text-center" },
                        React.createElement('div', null,
                            React.createElement('span', { className: "text-[9px] opacity-40 block uppercase" }, "Distancia"),
                            React.createElement('span', { className: "text-xl font-black text-sky-400" }, formatDistance(finalGpsSummary.distance))
                        ),
                        React.createElement('div', null,
                            React.createElement('span', { className: "text-[9px] opacity-40 block uppercase" }, "Tiempo"),
                            React.createElement('span', { className: "text-xl font-black text-emerald-400" }, formatTime(finalGpsSummary.time))
                        ),
                        React.createElement('div', null,
                            React.createElement('span', { className: "text-[9px] opacity-40 block uppercase" }, "Ritmo Promedio"),
                            React.createElement('span', { className: "text-xl font-black text-purple-400" }, finalGpsSummary.pace, " /km")
                        ),
                        React.createElement('div', null,
                            React.createElement('span', { className: "text-[9px] opacity-40 block uppercase" }, "Velocidad Media"),
                            React.createElement('span', { className: "text-xl font-black text-yellow-400" }, formatSpeed(finalGpsSummary.distance, finalGpsSummary.time))
                        )
                    )
                ),
                React.createElement('div', { className: "flex gap-4 mb-4" },
                    React.createElement('button', {
                        onClick: handleSave,
                        className: "flex-1 bg-white/10 text-white py-4 rounded-full font-black uppercase italic active:scale-95 text-xs flex items-center justify-center"
                    }, React.createElement(IconSave, { className: "mr-2" }), "GUARDAR MAPA"),
                    React.createElement('button', {
                        onClick: handleShare,
                        className: "flex-1 bg-white/10 text-white py-4 rounded-full font-black uppercase italic active:scale-95 text-xs flex items-center justify-center"
                    }, React.createElement(IconShare, { className: "mr-2" }), "COMPARTIR")
                ),
                React.createElement('button', {
                    onClick: onClose,
                    className: "w-full bg-orange-500 py-6 rounded-full font-black uppercase text-white active:scale-95 italic mt-auto"
                }, "FINALIZAR")
            );
        }

        function PlayerView({ workout, onExit, onComplete }) {
            const [uiStatus, setUiStatus] = useState('ready');
            const [uiIdx, setUiIdx] = useState(0);
            const [uiTimeLeft, setUiTimeLeft] = useState(0);
            const [uiElapsed, setUiElapsed] = useState(0);
            const [steps, setSteps] = useState([]);
            const [isModeSelectionScreenVisible, setIsModeSelectionScreenVisible] = useState(true);
            const [selectedWorkoutPhases, setSelectedWorkoutPhases] = useState(null);
            const [showPostWorkoutMap, setShowPostWorkoutMap] = useState(false);
            const [isGpsActive, setIsGpsActive] = useState(false);
            // const [showGpsControls, setShowGpsControls] = useState(false); // REMOVED
            const [gpsCoordinates, setGpsCoordinates] = useState([]);
            const [hasGpsData, setHasGpsData] = useState(false);
            const [finalGpsSummary, setFinalGpsSummary] = useState(null);
            const [shouldAutoStart, setShouldAutoStart] = useState(false);

            const statusRef = useRef(uiStatus);
            const idxRef = useRef(uiIdx);
            const timeLeftRef = useRef(uiTimeLeft);
            const elapsedRef = useRef(uiElapsed);
            const stepsRef = useRef([]);
            const stepDurRef = useRef(0);
            const stepStartRef = useRef(null);
            const workoutStartRef = useRef(null);
            const pausedAtRef = useRef(null);
            const savedRef = useRef(false);
            const spokenInit = useRef({});
            const lastSpokenKey = useRef('');
            const wakeLockRef = useRef(null);
            const videoRef = useRef(null);
            const gpsWatcherId = useRef(null);
            const lastPosition = useRef(null);
            const gpsStartTime = useRef(null);
            const gpsAnnounceLastTime = useRef(0);
            const gpsTotalDistance = useRef(0);
            const gpsTotalTime = useRef(0);
            const hasGpsDataRef = useRef(false);
            const isGpsActiveRef = useRef(isGpsActive); 
            const stopGpsTrackingRef = useRef(); 
            const intervalIdRef = useRef(null); 

            console.log('PlayerView: Render. Status:', uiStatus, 'Idx:', uiIdx, 'TimeLeft:', uiTimeLeft, 'Elapsed:', uiElapsed, 'ModeScreen:', isModeSelectionScreenVisible, 'Phases:', selectedWorkoutPhases?.length || 0, 'Steps:', steps.length);

            // Keep refs updated for latest state values
            useEffect(() => { statusRef.current = uiStatus; }, [uiStatus]);
            useEffect(() => { idxRef.current = uiIdx; }, [uiIdx]);
            useEffect(() => { timeLeftRef.current = uiTimeLeft; }, [uiTimeLeft]);
            useEffect(() => { elapsedRef.current = uiElapsed; }, [uiElapsed]);
            useEffect(() => { hasGpsDataRef.current = hasGpsData; }, [hasGpsData]);
            useEffect(() => { isGpsActiveRef.current = isGpsActive; }, [isGpsActive]); 

            const setTime = useCallback((t) => {
                if (isNaN(t)) { console.error('PlayerView: setTime received NaN. Resetting to 0.'); setUiTimeLeft(0); }
                else { setUiTimeLeft(t); }
            }, []);
            const setElap = useCallback((e) => {
                if (isNaN(e)) { console.error('PlayerView: setElap received NaN. Resetting to 0.'); setUiElapsed(0); }
                else { setUiElapsed(e); }
            }, []);

            const announceGpsStats = useCallback((distance, timeSec) => {
                const formattedDistance = formatDistance(distance);
                const formattedSpeed = formatSpeed(distance, timeSec);
                const formattedPace = formatPace(distance, timeSec);
                speak(`Distancia: ${formattedDistance}. Velocidad promedio: ${formattedSpeed}. Ritmo promedio: ${formattedPace}.`);
            }, []);

            const handleSpeech = useCallback((step, stepIdx, remaining) => {
                if (statusRef.current !== 'running' && statusRef.current !== 'gps-running') return;

                const initKey = `${stepIdx}_init`;
                if (remaining === step.seconds && step.voiceInitial && !spokenInit.current[initKey] && statusRef.current === 'running') {
                    speak(step.voiceInitial, true);
                    if (step.whistleOnStart) navigator.vibrate(150);
                    spokenInit.current[initKey] = true;
                }
                if (step.voiceMidpoint && remaining === step.voiceMidpoint.time) {
                    const k = `${stepIdx}_mid_${remaining}`;
                    if (lastSpokenKey.current !== k) { speak(step.voiceMidpoint.text); lastSpokenKey.current = k; }
                }
                if (step.voiceCountdown && remaining > 0 && remaining <= 3) {
                    const k = `${stepIdx}_cd_${remaining}`;
                    if (lastSpokenKey.current !== k) { speak(String(remaining)); lastSpokenKey.current = k; }
                }
                if (step.whistleOnStart && remaining === step.seconds && statusRef.current === 'running' && step.phase !== GPS_PHASE_KEY && !spokenInit.current[initKey + '_whistle']) {
                    whistle();
                    spokenInit.current[initKey + '_whistle'] = true;
                }
            }, []);

            const endWorkout = useCallback(() => {
                console.log('PlayerView: endWorkout called. Current elapsed:', elapsedRef.current);
                if (intervalIdRef.current) {
                    clearInterval(intervalIdRef.current);
                    intervalIdRef.current = null;
                    console.log('PlayerView: Interval cleared directly by endWorkout.');
                }
                setUiStatus('finished');
                speak('Entrenamiento finalizado. ¡Buen trabajo!', true, () => {
                    if (hasGpsDataRef.current && finalGpsSummary) {
                        console.log('PlayerView: Showing post-workout map.');
                        setShowPostWorkoutMap(true);
                    } else {
                        if (!savedRef.current && workout) {
                            console.log('PlayerView: Completing workout without GPS data.');
                            onComplete(workout.name, elapsedRef.current, null);
                            savedRef.current = true;
                        }
                        onExit();
                    }
                });
            }, [workout, onComplete, onExit, finalGpsSummary, setUiStatus]);

            const advanceToStep = useCallback((nextIdx) => {
                const s = stepsRef.current;
                if (nextIdx >= s.length) {
                    console.log('PlayerView: No more steps to advance to. Ending workout.');
                    endWorkout();
                    return false;
                }
                console.log('PlayerView: Advancing to step', nextIdx, 'Label:', s[nextIdx].label);
                idxRef.current = nextIdx;
                stepDurRef.current = s[nextIdx].seconds;
                timeLeftRef.current = s[nextIdx].seconds;
                stepStartRef.current = Date.now();
                lastSpokenKey.current = '';
                spokenInit.current = {};
                setUiIdx(nextIdx);
                setTime(s[nextIdx].seconds);
                return true;
            }, [endWorkout, setUiIdx, setTime]);

            const stopGpsTracking = useCallback((isSkip = false) => {
                console.log('PlayerView: stopGpsTracking called. isSkip:', isSkip);
                if (gpsWatcherId.current) {
                    navigator.geolocation.clearWatch(gpsWatcherId.current);
                    gpsWatcherId.current = null;
                    console.log('PlayerView: GPS watch cleared.');
                }

                const finalDistance = gpsTotalDistance.current;
                const finalTime = gpsTotalTime.current;

                if (finalDistance > 0 && finalTime > 0 && gpsCoordinates.length > 1) {
                    setHasGpsData(true);
                    setFinalGpsSummary({
                        distance: finalDistance,
                        time: finalTime,
                        pace: formatPace(finalDistance, finalTime),
                        speed: formatSpeed(finalDistance, finalTime)
                    });
                    console.log('PlayerView: GPS data collected and summarized:', { finalDistance, finalTime });
                } else {
                    setHasGpsData(false);
                    setFinalGpsSummary(null);
                    console.log('PlayerView: No significant GPS data collected.');
                }

                speak('Seguimiento de caminata o carrera finalizado.', true, () => {
                    if (finalDistance > 0 && finalTime > 0) {
                        announceGpsStats(finalDistance, finalTime);
                    } else {
                        speak('No se registró distancia significativa.');
                    }
                    setIsGpsActive(false);
                    // setShowGpsControls(false); // REMOVED
                    setUiStatus('running'); // Transición a 'running' para que el resto de la rutina continúe si no es el último paso.
                    if (!isSkip) {
                        console.log('PlayerView: Auto-skipping to next step after GPS phase.');
                        const next = idxRef.current + 1;
                        advanceToStep(next);
                    }
                });
            }, [advanceToStep, announceGpsStats, gpsCoordinates, setHasGpsData, setFinalGpsSummary, setUiStatus, setIsGpsActive]); // Removed setShowGpsControls from dependencies

            // useEffect para mantener la ref de stopGpsTracking actualizada
            useEffect(() => {
                stopGpsTrackingRef.current = stopGpsTracking;
            }, [stopGpsTracking]);


            const skipStep = useCallback(() => {
                if (statusRef.current === 'finished' || stepsRef.current.length === 0) {
                    console.log('PlayerView: Skip request ignored. Status:', statusRef.current, 'Steps length:', stepsRef.current.length);
                    return;
                }
                console.log('PlayerView: Skip step requested.');
                const currentStep = stepsRef.current[idxRef.current];
                if (currentStep.phase === GPS_PHASE_KEY && isGpsActiveRef.current) {
                    console.log('PlayerView: Stopping GPS tracking due to skip.');
                    stopGpsTrackingRef.current(true); 
                    return;
                }

                const next = idxRef.current + 1;
                if (advanceToStep(next)) {
                    speak('Saltando. Siguiente.', true);
                    if (stepsRef.current[next] && stepsRef.current[next].phase !== GPS_PHASE_KEY) { 
                        handleSpeech(stepsRef.current[next], next, stepsRef.current[next].seconds);
                    }
                } else {
                    endWorkout();
                }
            }, [endWorkout, advanceToStep, handleSpeech]);

            const startGpsTracking = useCallback(() => {
                console.log('PlayerView: startGpsTracking called.');
                if (intervalIdRef.current) {
                    clearInterval(intervalIdRef.current);
                    intervalIdRef.current = null;
                    console.log('PlayerView: Non-GPS interval cleared by startGpsTracking.');
                }

                if (!('geolocation' in navigator)) {
                    speak('Error: Geolocalización no disponible. No se puede iniciar el seguimiento.');
                    console.error("Geolocation is not supported by this browser. Skipping GPS tracking.");
                    setIsGpsActive(false);
                    setUiStatus('running'); 
                    skipStep();
                    return;
                }
                if (isGpsActiveRef.current) {
                    console.warn('PlayerView: GPS is already active, preventing multiple starts.');
                    return;
                }

                // Removed "Presiona el botón de encendido del celular para ver el botón de finalizar."
                speak('Iniciando seguimiento de caminata o carrera. Las actualizaciones serán por audio cada diez minutos.', true);
                setIsGpsActive(true);
                // setShowGpsControls(true); // REMOVED: button visible by default when GPS is active
                setUiStatus('gps-running'); 

                gpsStartTime.current = Date.now();
                lastPosition.current = null;
                gpsTotalDistance.current = 0;
                gpsTotalTime.current = 0;
                setGpsCoordinates([]);
                setHasGpsData(false);
                setFinalGpsSummary(null);
                gpsAnnounceLastTime.current = gpsStartTime.current;
                console.log('PlayerView: GPS tracking initialized. Requesting watchPosition.');

                const options = { enableHighAccuracy: true, timeout: 10000, maximumAge: 0 };

                gpsWatcherId.current = navigator.geolocation.watchPosition(
                    (position) => {
                        const { latitude, longitude } = position.coords;
                        const now = Date.now();
                        const timeElapsedMs = now - gpsStartTime.current;
                        const currentGpsTotalTime = Math.floor(timeElapsedMs / 1000);
                        gpsTotalTime.current = currentGpsTotalTime;

                        let currentDistance = gpsTotalDistance.current;
                        if (lastPosition.current) {
                            const dist = getDistance(
                                lastPosition.current.latitude,
                                lastPosition.current.longitude,
                                latitude,
                                longitude
                            );
                            currentDistance += dist;
                            gpsTotalDistance.current = currentDistance;
                        }
                        lastPosition.current = { latitude, longitude, timestamp: now };
                        setGpsCoordinates(prev => [...prev, { lat: latitude, lng: longitude, timestamp: now }]);

                        if (statusRef.current === 'gps-running' && currentGpsTotalTime > 0 && (now - gpsAnnounceLastTime.current) >= (10 * 60 * 1000)) {
                            console.log('PlayerView: Announcing GPS stats.');
                            announceGpsStats(gpsTotalDistance.current, currentGpsTotalTime);
                            gpsAnnounceLastTime.current = now;
                        }
                    },
                    (error) => {
                        console.error("PlayerView: GPS Error:", error);
                        speak(`Error de GPS: ${error.message}. Deteniendo seguimiento.`);
                        stopGpsTrackingRef.current(); 
                    },
                    options
                );
            }, [skipStep, announceGpsStats, setHasGpsData, setUiStatus, setIsGpsActive]); // Removed setShowGpsControls from dependencies

            const togglePlay = useCallback(() => {
                if (!workout || stepsRef.current.length === 0) {
                    console.warn('togglePlay: Cannot toggle play, workout or steps missing. Workout:', workout, 'Steps length:', stepsRef.current.length);
                    speak('No se puede iniciar la rutina. Verifica la configuración.', true);
                    return;
                }
                const current = statusRef.current;
                console.log('togglePlay called. Current status (from ref):', current);

                if (current === 'ready') {
                    const now = Date.now(); 
                    workoutStartRef.current = now;
                    stepStartRef.current = now;
                    setUiStatus('running');
                    console.log('togglePlay: Transitioned from ready to running.');
                } else if (current === 'running') {
                    pausedAtRef.current = Date.now();
                    setUiStatus('paused');
                    console.log('togglePlay: Transitioned from running to paused.');
                } else if (current === 'paused') {
                    const now = Date.now();
                    const pausedMs = pausedAtRef.current ? now - pausedAtRef.current : 0;
                    console.log('togglePlay: Resuming from pause. Paused time (ms):', pausedMs);

                    workoutStartRef.current = (workoutStartRef.current !== null && !isNaN(workoutStartRef.current)) ? workoutStartRef.current + pausedMs : now;
                    stepStartRef.current = (stepStartRef.current !== null && !isNaN(stepStartRef.current)) ? stepStartRef.current + pausedMs : now; 

                    if (isNaN(workoutStartRef.current)) workoutStartRef.current = now;
                    if (isNaN(stepStartRef.current)) stepStartRef.current = now;

                    pausedAtRef.current = null;
                    setUiStatus('running');
                    console.log('togglePlay: Transitioned from paused to running. New workoutStartRef:', workoutStartRef.current, 'stepStartRef:', stepStartRef.current);
                } else if (current === 'gps-running') {
                    // Removed specific message for GPS pause. User will use the dedicated button.
                    speak('No se puede pausar durante el seguimiento GPS. Por favor, utiliza el botón "TERMINAR CAMINATA / CARRERA" para finalizar.', true);
                    console.log('togglePlay: Attempted pause during GPS, ignored.');
                }
            }, [workout, setUiStatus]); 

            const releaseWake = useCallback(() => {
                if (videoRef.current) videoRef.current.pause();
                if (wakeLockRef.current) {
                    console.log('PlayerView: Releasing wake lock.');
                    wakeLockRef.current.release().then(() => wakeLockRef.current = null)
                                       .catch((e) => console.warn("PlayerView: Error releasing wake lock:", e));
                }
            }, []);

            const requestWake = useCallback(async () => {
                try {
                    if (videoRef.current && statusRef.current === 'running') {
                        videoRef.current.play().catch(() => {});
                    } else if (videoRef.current) {
                        videoRef.current.pause(); 
                    }

                    if (statusRef.current === 'running' && 'wakeLock' in navigator && !wakeLockRef.current) {
                        wakeLockRef.current = await navigator.wakeLock.request('screen');
                        console.log('PlayerView: Wake lock requested for running state.');
                    } else if (statusRef.current !== 'running' && wakeLockRef.current) {
                        releaseWake();
                    }
                } catch (e) {
                    console.warn("PlayerView: WakeLock failed:", e);
                }
            }, [releaseWake]); 

            useEffect(() => {
                if (uiStatus === 'running') {
                    requestWake();
                } else {
                    releaseWake();
                }
                return releaseWake; 
            }, [uiStatus, requestWake, releaseWake]);

            useEffect(() => {
                const handleVisibilityChange = () => {
                    console.log('PlayerView: Visibility changed to', document.hidden ? 'hidden' : 'visible', 'Current UI Status:', uiStatus);
                    if (document.hidden) {
                        if (statusRef.current === 'running') {
                            pausedAtRef.current = Date.now();
                            setUiStatus('paused');
                        } 
                        // For 'gps-running', nothing changes visually, GPS continues tracking.
                        releaseWake(); 
                    } else {
                        if (statusRef.current === 'paused' && pausedAtRef.current !== null) {
                            const hiddenMs = Date.now() - pausedAtRef.current;
                            workoutStartRef.current = (workoutStartRef.current !== null && !isNaN(workoutStartRef.current)) ? workoutStartRef.current + hiddenMs : Date.now(); 
                            stepStartRef.current = (stepStartRef.current !== null && !isNaN(stepStartRef.current)) ? stepStartRef.current + hiddenMs : Date.now(); 
                            pausedAtRef.current = null;
                            setUiStatus('running'); 
                        } 
                        // For 'gps-running', screen just becomes visible, UI shows button automatically.
                    }
                };
                document.addEventListener('visibilitychange', handleVisibilityChange);
                return () => document.removeEventListener('visibilitychange', handleVisibilityChange);
            }, [releaseWake, uiStatus, setUiStatus]); // Removed setShowGpsControls from dependencies

            // Main useEffect for initialization and step generation
            useEffect(() => {
                console.log('PlayerView: Init useEffect (main): dependencies changed. ', { workout, isModeSelectionScreenVisible, selectedWorkoutPhases });

                // Reinicia todos los estados relevantes para una nueva sesión.
                setUiStatus('ready'); 
                setUiIdx(0);
                setElap(0);
                setTime(0);
                savedRef.current = false;
                spokenInit.current = {};
                lastSpokenKey.current = '';
                workoutStartRef.current = null;
                stepStartRef.current = null;
                pausedAtRef.current = null;
                setShowPostWorkoutMap(false);
                setGpsCoordinates([]);
                setHasGpsData(false);
                setFinalGpsSummary(null);
                setShouldAutoStart(false); 
                setIsGpsActive(false); 
                // setShowGpsControls(false); // REMOVED

                if (gpsWatcherId.current) {
                    navigator.geolocation.clearWatch(gpsWatcherId.current);
                    gpsWatcherId.current = null;
                    console.log('PlayerView: Init useEffect (main): GPS watch cleared during reset.');
                }

                if (intervalIdRef.current) {
                    clearInterval(intervalIdRef.current);
                    intervalIdRef.current = null;
                    console.log('PlayerView: Init useEffect (main): Cleared any orphaned interval.');
                }

                if (isModeSelectionScreenVisible || !workout || !selectedWorkoutPhases) {
                    console.log('PlayerView: Init useEffect (main): Mode selection visible or no workout/phases. Not generating steps.');
                    setSteps([]);
                    return;
                }

                console.log('PlayerView: Init useEffect (main): Generating workout steps...');
                const generated = generateWorkoutSteps(workout, DEFAULT_PARAMS, selectedWorkoutPhases);
                stepsRef.current = generated;
                setSteps(generated);

                if (generated.length === 0 || generated[0].phase === 'error') {
                    console.error("PlayerView: Init useEffect (main): Generated steps are empty or error. Cannot auto-start.");
                    return;
                }

                const firstStep = generated[0];
                stepDurRef.current = firstStep.seconds;
                setTime(firstStep.seconds);
                setUiIdx(0);
                setShouldAutoStart(true); 

                return () => {
                    console.log('PlayerView: Init useEffect (main) cleanup: Executing cleanup.');
                    if (isGpsActiveRef.current && stopGpsTrackingRef.current) { 
                        console.log('PlayerView: Cleanup calling stopGpsTracking(true) via ref.');
                        stopGpsTrackingRef.current(true); 
                    }
                    if (intervalIdRef.current) {
                        clearInterval(intervalIdRef.current);
                        intervalIdRef.current = null;
                        console.log('PlayerView: Init useEffect (main) cleanup: Cleared main timer interval on unmount/re-init.');
                    }
                };
            }, [
                workout,
                isModeSelectionScreenVisible,
                selectedWorkoutPhases,
            ]);


            // Nuevo useEffect para manejar el auto-inicio de la rutina
            useEffect(() => {
                if (shouldAutoStart && uiStatus === 'ready') {
                    console.log('PlayerView: Auto-start useEffect: Triggering togglePlay.');
                    togglePlay();
                    setShouldAutoStart(false); 
                }
            }, [shouldAutoStart, uiStatus, togglePlay]);


            useEffect(() => {
                if (intervalIdRef.current) {
                    clearInterval(intervalIdRef.current);
                    intervalIdRef.current = null;
                    console.log('PlayerView: Timer useEffect: Cleared existing interval before potential new one.');
                }

                if (uiStatus !== 'running' && uiStatus !== 'gps-running') {
                    console.log('PlayerView: Timer useEffect skipped. Status is not running/gps-running:', uiStatus);
                    return; 
                }
                console.log('PlayerView: Timer useEffect activated. Status:', uiStatus);

                const interval = setInterval(() => {
                    const now = Date.now();
                    const s = stepsRef.current;
                    const ci = idxRef.current;
                    const step = s[ci];

                    if (!step) {
                        console.error("PlayerView: Timer: No step found at current index (", ci, "). Steps array:", s, ". Ending workout.");
                        endWorkout();
                        return;
                    }

                    const currentWorkoutStart = workoutStartRef.current;
                    const totalElap = Math.floor((now - (currentWorkoutStart !== null && !isNaN(currentWorkoutStart) ? currentWorkoutStart : now)) / 1000);
                    if (!isNaN(totalElap)) {
                        elapsedRef.current = totalElap;
                        setElap(totalElap);
                    } else {
                        console.error('PlayerView: Timer: Calculated totalElap is NaN. Resetting to 0. Debug values: now=', now, 'workoutStartRef.current=', workoutStartRef.current);
                        elapsedRef.current = 0;
                        setElap(0);
                    }

                    if (statusRef.current !== 'running' && statusRef.current !== 'gps-running') {
                        console.log('PlayerView: Timer: Inside interval, status changed to non-running/gps-running (was', statusRef.current, '). Stopping processing.');
                        return;
                    }
                    
                    if (statusRef.current === 'gps-running') {
                        // If GPS is running, we only update elapsed time, not step countdown.
                        // The step advancement for GPS is handled manually by stopGpsTrackingRef.current()
                        return;
                    }

                    const currentStepStart = stepStartRef.current;
                    const passed = Math.floor((now - (currentStepStart !== null && !isNaN(currentStepStart) ? currentStepStart : now)) / 1000);
                    const remaining = Math.max(0, stepDurRef.current - passed);

                    if (!isNaN(remaining)) {
                        timeLeftRef.current = remaining;
                        setTime(remaining);
                    } else {
                        console.error('PlayerView: Timer: Calculated remaining is NaN. Resetting to 0. Debug values: remaining=', remaining, 'stepDurRef.current=', stepDurRef.current, 'passed=', passed, 'now=', now, 'stepStartRef.current=', stepStartRef.current);
                        timeLeftRef.current = 0;
                        setTime(0);
                    }

                    handleSpeech(step, ci, remaining);

                    if (remaining === 0) {
                        if (step.phase === GPS_PHASE_KEY) {
                            console.log('PlayerView: Timer: GPS countdown finished. Initiating GPS tracking.');
                            startGpsTracking();
                            return; 
                        }

                        const next = ci + 1;
                        if (next < s.length) {
                            advanceToStep(next);
                            if (s[next].phase !== GPS_PHASE_KEY) {
                                handleSpeech(s[next], next, s[next].seconds);
                            }
                        } else {
                            endWorkout();
                        }
                    }
                }, 250);
                intervalIdRef.current = interval; 

                return () => {
                    console.log('PlayerView: Timer useEffect cleanup. Clearing interval.');
                    clearInterval(interval);
                    intervalIdRef.current = null;
                };
            }, [
                uiStatus,
                endWorkout,
                setElap,
                setTime,
                startGpsTracking,
                advanceToStep,
                handleSpeech
            ]);

            const handleGpsSummaryClosed = useCallback(() => {
                console.log('PlayerView: GpsMapSummary closed.');
                setShowPostWorkoutMap(false);
                const nextIdx = idxRef.current + 1;
                if (nextIdx < stepsRef.current.length) {
                    console.log('PlayerView: More steps remaining after GPS. Advancing to next step.');
                    advanceToStep(nextIdx); 
                } else {
                    console.log('PlayerView: No more steps after GPS. Completing workout.');
                    if (!savedRef.current && workout) {
                        onComplete(workout.name, elapsedRef.current, { coordinates: gpsCoordinates, summary: finalGpsSummary });
                        savedRef.current = true;
                    }
                    onExit(); 
                }
            }, [advanceToStep, workout, onComplete, onExit, gpsCoordinates, finalGpsSummary]);


            if (!workout) {
                console.log('PlayerView: Rendering error: Workout not selected.');
                return React.createElement('div', { className: "h-screen flex items-center justify-center bg-slate-950 text-white/50 text-sm italic" }, "Error: Rutina no seleccionada. Por favor, vuelve a la lista.");
            }

            if (isModeSelectionScreenVisible) {
                console.log('PlayerView: Rendering ModeSelectionScreen.');
                return React.createElement(ModeSelectionScreen, {
                    onModeSelected: (phases) => {
                        setSelectedWorkoutPhases(phases);
                        setIsModeSelectionScreenVisible(false);
                        console.log('PlayerView: Mode selected, hiding selection screen.');
                    },
                    onCancel: onExit
                });
            }

            if (steps.length === 0 && !isModeSelectionScreenVisible) {
                console.log('PlayerView: Rendering error: No steps generated.');
                return React.createElement('div', { className: "h-screen flex flex-col items-center justify-center bg-slate-950 text-white/50 text-sm italic p-4" },
                    React.createElement('p', { className: "mb-4" }, "Error: No se pudieron generar los pasos de la rutina con las fases seleccionadas."),
                    React.createElement('p', { className: "mb-8" }, "Por favor, vuelve a la lista de rutinas e inténtalo de nuevo seleccionando al menos una fase."),
                    React.createElement('button', { onClick: onExit, className: "w-full max-w-sm bg-white/10 text-white py-4 rounded-full font-black uppercase active:scale-95 italic text-xs" }, "Volver a Rutinas")
                );
            }

            if (showPostWorkoutMap) {
                console.log('PlayerView: Rendering GpsMapSummary.');
                return React.createElement(GpsMapSummary, {
                    gpsCoordinates,
                    finalGpsSummary,
                    onSave: () => {},
                    onShare: () => {},
                    onClose: handleGpsSummaryClosed 
                });
            }

            // Simplified GPS tracking UI: button is always present when screen is on and GPS is active
            if (isGpsActive && uiStatus === 'gps-running') {
                console.log('PlayerView: Rendering GPS tracking UI.');
                return React.createElement('div', { className: "h-screen flex flex-col items-center justify-center bg-slate-950 text-white p-6" },
                    React.createElement(React.Fragment, null,
                        React.createElement('h2', { className: "text-3xl font-black uppercase text-orange-500 mb-4" }, "Caminata / Carrera"),
                        React.createElement('p', { className: "text-lg text-slate-400 mb-10" }, "Seguimiento GPS Activo. Actualizaciones solo por voz."),
                        React.createElement('button', {
                            onClick: () => stopGpsTrackingRef.current(), 
                            className: "w-full max-w-sm bg-red-600/80 text-white py-6 rounded-full font-black uppercase active:scale-95 italic"
                        }, "TERMINAR CAMINATA / CARRERA")
                    )
                );
            }

            if (uiStatus === 'finished') {
                console.log('PlayerView: Rendering Finished screen.');
                return React.createElement('div', { className: "h-screen flex flex-col items-center justify-center p-8 bg-slate-950 text-white text-center" },
                    React.createElement('h1', { className: "text-5xl font-black italic mb-4" }, "¡HECHO!"),
                    React.createElement('button', { onClick: onExit, className: "w-full max-w-sm bg-white text-black py-6 rounded-full font-black uppercase" }, "Finalizar")
                );
            }

            const curr = steps[uiIdx] || { label: 'Cargando...', color: 'bg-slate-950' };
            const showOverlay = uiStatus === 'ready' || uiStatus === 'paused';

            console.log('PlayerView: Rendering main UI. Status:', uiStatus, 'Current Step Label:', curr.label, 'Time Left:', uiTimeLeft, 'Elapsed:', uiElapsed);
            return React.createElement('div', { className: `h-screen flex flex-col transition-colors duration-700 ${curr.color || 'bg-slate-950'} text-white` },
                React.createElement('video', { ref: videoRef, loop: true, muted: true, playsInline: true, style: { position: 'absolute', width: '1px', height: '1px', opacity: 0.01 } },
                    React.createElement('source', { src: "https://raw.githubusercontent.com/intel-iot-devkit/sample-videos/master/one-second-loop.mp4", type: "video/mp4" })
                ),
                React.createElement('div', { className: "bg-black/10 p-4 pt-10 flex justify-between items-center shrink-0 z-10" },
                    React.createElement('div', { className: "leading-none text-left" },
                        React.createElement('span', { className: "text-[10px] font-black text-orange-500 uppercase" }, "Tiempo Total"),
                        React.createElement('p', { className: "text-xl font-black italic" }, formatTime(uiElapsed))
                    ),
                    React.createElement('div', { className: "text-center" },
                        React.createElement('h2', { className: "text-[10px] font-black uppercase italic truncate max-w-[120px] tracking-tight" }, workout.name || 'Rutina')
                    ),
                    React.createElement('button', { onClick: onExit, className: "opacity-40 text-xl font-black px-2" }, "✕")
                ),
                React.createElement('div', { className: "flex-1 flex flex-col items-center justify-center text-center px-4 min-h-0 relative" },
                    showOverlay && React.createElement('div', { className: "absolute inset-0 z-40 bg-slate-950/40 backdrop-blur-sm flex items-center justify-center" },
                        React.createElement('button', { onClick: togglePlay, className: "bg-orange-500 p-10 rounded-full shadow-2xl active:scale-90" },
                            React.createElement(IconPlay, null)
                        )
                    ),
                    React.createElement('h2', { className: "text-[11vw] font-black uppercase italic text-white/80 leading-none mb-2" }, curr.label || 'LISTO'),
                    React.createElement('div', { className: "timer-huge tabular-nums text-white" }, uiTimeLeft)
                ),
                React.createElement('div', { className: "bg-slate-950 p-6 pb-10 flex flex-col items-center shrink-0" },
                    React.createElement('div', { className: "w-full max-w-md grid grid-cols-3 items-center mb-6 text-center italic" },
                        React.createElement('button', { onClick: skipStep, className: "bg-slate-800/40 py-4 rounded-xl text-[10px] font-black uppercase text-white/70 active:scale-95" }, "Saltar"),
                        React.createElement('div', { className: "flex justify-center" },
                            uiStatus !== 'ready' && React.createElement('button', {
                                onClick: togglePlay,
                                className: "w-20 h-20 rounded-full border-4 border-yellow-400 flex items-center justify-center active:scale-90"
                            },
                                uiStatus === 'running' ? React.createElement(IconPause, null) : React.createElement(IconPlay, null)
                            )
                        ),
                        React.createElement('button', { onClick: endWorkout, className: "bg-red-500/20 py-4 rounded-xl text-[10px] font-black uppercase text-red-400 active:scale-95" }, "Finalizar")
                    ),
                    React.createElement('div', { className: "w-full max-w-md grid grid-cols-2 items-center text-center italic" },
                        React.createElement('div', { className: "flex flex-col" },
                            React.createElement('span', { className: "text-[14vw] font-black text-sky-400 leading-none" }, curr.tr ? curr.tr - (curr.r || 0) + 1 : '-'),
