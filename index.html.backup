<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#020617">
    <title>Mi Entrenador Saludable</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
    <script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&display=swap');
        body {
            font-family: 'Inter', sans-serif; background-color: #020617; color: white;
            margin: 0; padding: 0; overflow: hidden; -webkit-tap-highlight-color: transparent;
            position: fixed; width: 100%; height: 100%;
        }
        #root { height: 100%; width: 100%; display: flex; flex-direction: column; }
        .glass-card {
            background: rgba(255,255,255,0.03); backdrop-filter: blur(10px);
            border: 1px solid rgba(255,255,255,0.05); border-radius: 1.5rem;
        }
        .scrollbar-hide::-webkit-scrollbar { display: none; }
        .timer-huge {
            font-size: 60vw; line-height: 0.75; font-weight: 900;
            letter-spacing: -0.06em; pointer-events: none;
        }
        @media (orientation: landscape) { .timer-huge { font-size: 75vh; } }
    </style>
</head>
<body>
    <div id="root"></div>

    <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-auth-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-firestore-compat.js"></script>

    <script type="text/babel">
        // --- Core React Hooks ---
        const { useState, useEffect, useRef } = React;

        // --- Icon Components ---
        const IconPlay    = () => <svg width="40" height="40" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>;
        const IconPause   = () => <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>;
        // IconRotate, IconBack, IconForward are not used, but kept for completeness
        const IconRotate  = () => <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="3"><path d="M1 4v6h6M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>;
        const IconBack    = () => <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M6 6h2v12H6zm3.5 6l8.5 6V6z"/></svg>;
        const IconForward = () => <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M6 18l8.5-6L6 6zM16 6v12h2V6z"/></svg>;

        // --- Firebase Initialization ---
        const firebaseConfig = {
            apiKey: "AIzaSyDg0nohFAprIYta3Z3IvFGms55PehyxGIM",
            authDomain: "entrenadorpersonal-4e69d.firebaseapp.com",
            projectId: "entrenadorpersonal-4e69d",
            storageBucket: "entrenadorpersonal-4e69d.firebasestorage.app",
            messagingSenderId: "198872357236",
            appId: "1:198872357236:web:c3cd2a7f5caff197847421"
        };
        if (!firebase.apps.length) firebase.initializeApp(firebaseConfig);
        const auth = firebase.auth();
        const db   = firebase.firestore();

        // --- Global Constants ---
        const APP_ID = "mientrenador-v3";
        const APP_TITLE = "Mi Entrenador Saludable";
        const APP_VERSION = "57.0.0";

        const WARMUP_STEPS = [
            { label: 'TOBILLO DERECHO', voice: 'Tobillo derecho' },
            { label: 'TOBILLO IZQUIERDO', voice: 'Tobillo izquierdo' },
            { label: 'RODILLAS DERECHA', voice: 'Rodillas a la derecha' },
            { label: 'RODILLAS IZQUIERDA', voice: 'Rodillas a la izquierda' },
            { label: 'CINTURA DERECHA', voice: 'Cintura a la derecha' },
            { label: 'CINTURA IZQUIERDA', voice: 'Cintura a la izquierda' },
            { label: 'BRAZO DERECHO', voice: 'Brazo derecho' },
            { label: 'BRAZO IZQUIERDO', voice: 'Brazo izquierdo' },
            { label: 'CUELLO ADELANTE Y ATRÁS', voice: 'Cuello adelante y atrás' },
            { label: 'CUELLO DER. E IZQ.', voice: 'Cuello derecha e izquierda' },
        ];

        const TRAINING_ZONES = ['PIERNAS', 'BRAZOS', 'TRONCO'];
        const DEFAULT_PARAMS = { 
            entrenamiento: { 
                action: 30, change: 5, rounds: 3, cycles: 4, rest: 60, zoneRest: 30,
                stretchSteps: 16, stretchAction: 30, stretchChange: 10 // Nuevos parámetros para estiramientos
            } 
        };
        const formatTime = (s) => `${Math.floor(s/60)}:${(s%60).toString().padStart(2,'0')}`;

        // --- Audio Functions ---
        const whistle = () => {
            try {
                const ctx = new (window.AudioContext || window.webkitAudioContext)();
                const now = ctx.currentTime;
                const duration = 1.6;
                const createOsc = (freq, type = 'sine', vol = 1.0) => {
                    const osc = ctx.createOscillator();
                    const gain = ctx.createGain();
                    const mod = ctx.createOscillator();
                    const modGain = ctx.createGain();
                    osc.type = type;
                    osc.frequency.setValueAtTime(freq, now);
                    mod.frequency.setValueAtTime(45, now); 
                    modGain.gain.setValueAtTime(freq * 0.1, now);
                    mod.connect(modGain); modGain.connect(osc.frequency);
                    osc.connect(gain); gain.connect(ctx.destination);
                    gain.gain.setValueAtTime(0, now);
                    gain.gain.linearRampToValueAtTime(vol, now + 0.05);
                    gain.gain.exponentialRampToValueAtTime(0.01, now + duration);
                    osc.start(now); mod.start(now);
                    osc.stop(now + duration); mod.stop(now + duration);
                };
                createOsc(3500); createOsc(3515, 'triangle', 0.5);
            } catch(e) { console.warn("Whistle failed:", e); }
        };

        // --- Speech Synthesis Functions ---
        const voiceQueue = [];
        let voiceBusy = false;
        const flushVoice = () => {
            if (voiceBusy || voiceQueue.length === 0 || !window.speechSynthesis) return;
            voiceBusy = true;
            const item = voiceQueue.shift();
            const text = typeof item === 'string' ? item : item.text;
            const onEndCallback = typeof item === 'object' && item.onEnd ? item.onEnd : () => {};

            const msg = new SpeechSynthesisUtterance(text);
            msg.lang = 'es-ES'; msg.rate = 1.05;
            msg.onend = msg.onerror = () => { 
                voiceBusy = false; 
                onEndCallback(); // Execute specific callback if provided
                flushVoice(); 
            };
            window.speechSynthesis.speak(msg);
        };
        const speak = (text, interrupt = false, onEnd = null) => {
            if (!window.speechSynthesis) return;
            if (interrupt) { window.speechSynthesis.cancel(); voiceQueue.length = 0; voiceBusy = false; }
            voiceQueue.push(onEnd ? { text, onEnd } : text); 
            flushVoice();
        };

        // --- Main App Component ---
        function App() {
            const [user, setUser] = useState(null);
            const [view, setView] = useState('workouts');
            const [workouts, setWorkouts] = useState([]);
            const [history, setHistory] = useState([]);
            const [loading, setLoading] = useState(true);
            const [selectedWorkout, setSelectedWorkout] = useState(null);

            useEffect(() => {
                const unsub = auth.onAuthStateChanged(u => {
                    setUser(u && !u.isAnonymous ? u : null);
                    // Add a small delay for smoother transition, even if auth is fast
                    setTimeout(() => setLoading(false), 500); 
                });
                return unsub;
            }, []);

            useEffect(() => {
                if (!user) return;
                const base = db.collection('artifacts').doc(APP_ID).collection('users').doc(user.uid);
                const unsubW = base.collection('workouts').onSnapshot(s => setWorkouts(s.docs.map(d => ({id:d.id,...d.data()}))));
                const unsubH = base.collection('history').onSnapshot(s => setHistory(s.docs.map(d => ({id:d.id,...d.data()}))));
                return () => { unsubW(); unsubH(); };
            }, [user]);

            const handleStartWorkout = (w) => {
                // Pre-warmup for speech synthesis
                if (window.speechSynthesis) {
                    const silent = new SpeechSynthesisUtterance(' ');
                    silent.volume = 0;
                    window.speechSynthesis.speak(silent);
                }
                setSelectedWorkout(w);
                setView('play');
            };

            if (loading) return <div className="h-full w-full flex items-center justify-center bg-slate-950"><div className="animate-spin w-8 h-8 border-4 border-orange-500 border-t-transparent rounded-full"/></div>;
            if (!user) return <AuthView APP_TITLE={APP_TITLE} APP_VERSION={APP_VERSION}/>;

            return (
                <div className="h-full w-full flex flex-col bg-slate-950 text-white overflow-hidden">
                    {view !== 'play' && (
                        <header className="p-5 flex justify-between items-center bg-slate-900 border-b border-white/5 shrink-0">
                            <div onClick={() => setView('workouts')} className="cursor-pointer">
                                <h1 className="text-lg font-black italic uppercase text-orange-500">{APP_TITLE}</h1>
                                <p className="text-[8px] text-slate-500 font-bold uppercase">{user.email} | V{APP_VERSION}</p>
                            </div>
                            <button onClick={() => auth.signOut()} className="p-2 bg-red-500/10 rounded-xl text-red-500 font-bold text-[10px] px-4 uppercase italic">Salir</button>
                        </header>
                    )}
                    <main className="flex-1 relative flex flex-col min-h-0">
                        {view === 'workouts' && <WorkoutsView workouts={workouts} user={user} onStart={handleStartWorkout} onEdit={w => { setSelectedWorkout(w); setView('create'); }} onCreate={() => { setSelectedWorkout(null); setView('create'); }} />}
                        {view === 'avance' && <AvanceView history={history} />}
                        {view === 'create' && <CreateView user={user} workoutToEdit={selectedWorkout} onCancel={() => setView('workouts')} />}
                        {view === 'play' && <PlayerView workout={selectedWorkout} onExit={() => setView('workouts')} onComplete={(name, time) => { db.collection('artifacts').doc(APP_ID).collection('users').doc(user.uid).collection('history').add({ workoutName:name, totalTime:time, date: new Date().toISOString() }); setView('workouts'); }} />}
                    </main>
                    {view !== 'play' && (
                        <nav className="bg-slate-900 border-t border-white/5 p-4 flex justify-around items-center shrink-0">
                            <button onClick={() => setView('workouts')} className={`flex flex-col items-center text-[9px] font-black ${view==='workouts'?'text-orange-500':'text-slate-500'}`}><span className="text-xl mb-1">🏋️</span>RUTINAS</button>
                            <button onClick={() => setView('avance')} className={`flex flex-col items-center text-[9px] font-black ${view==='avance'?'text-orange-500':'text-slate-500'}`}><span className="text-xl mb-1">📊</span>AVANCE</button>
                        </nav>
                    )}
                </div>
            );
        }

        // --- Auth View Component ---
        function AuthView({APP_TITLE, APP_VERSION}) {
            const [isReg, setIsReg] = useState(false);
            const [email, setEmail] = useState('');
            const [pass, setPass] = useState('');
            const handle = async e => { e.preventDefault(); try { if (isReg) await auth.createUserWithEmailAndPassword(email.trim(), pass); else await auth.signInWithEmailAndPassword(email.trim(), pass); } catch (err) { alert("Error: " + err.message); } };
            return (
                <div className="h-screen flex flex-col items-center bg-slate-950 p-10 pt-20 text-center">
                    <div className="text-7xl mb-6">🏃‍♂️</div>
                    <h1 className="text-4xl font-black italic uppercase text-white">{APP_TITLE}</h1>
                    <p className="text-[8px] text-slate-600 uppercase mb-8">V {APP_VERSION}</p>
                    <form onSubmit={handle} className="space-y-4 w-full max-w-sm">
                        <input type="email" placeholder="EMAIL" className="w-full p-6 bg-slate-900 border border-white/5 rounded-[1.5rem] text-center text-white outline-none" value={email} onChange={e=>setEmail(e.target.value)} required />
                        <input type="password" placeholder="CLAVE" className="w-full p-6 bg-slate-900 border border-white/5 rounded-[1.5rem] text-center text-white outline-none" value={pass} onChange={e=>setPass(e.target.value)} required />
                        <button type="submit" className="w-full bg-orange-500 py-6 rounded-full font-black uppercase text-white active:scale-95 italic">{isReg?'REGISTRARSE':'ENTRAR'}</button>
                    </form>
                    <button onClick={()=>setIsReg(!isReg)} className="mt-8 text-slate-500 text-[10px] uppercase font-black">{isReg?'YA TENGO CUENTA':'CREAR CUENTA NUEVA'}</button>
                </div>
            );
        }

        // --- Workouts List View Component ---
        function WorkoutsView({ workouts, user, onStart, onEdit, onCreate }) {
            return (
                <div className="flex-1 overflow-y-auto scrollbar-hide p-4 space-y-4 pb-32">
                    {workouts.length === 0 ? <div className="text-center p-12 opacity-30 italic font-black text-[10px]">Sin rutinas</div> : workouts.map(w => (
                        <div key={w.id} className="glass-card p-6 flex justify-between items-center shadow-lg">
                            <div className="flex-1 cursor-pointer" onClick={()=>onStart(w)}><h3 className="font-black uppercase italic text-sm">{w.name}</h3><span className="text-[10px] text-orange-400 font-black uppercase italic">Activa</span></div>
                            <div className="flex gap-2">
                                <button onClick={()=>onStart(w)} className="bg-white text-black p-4 rounded-xl"><IconPlay/></button>
                                <button onClick={()=>onEdit(w)} className="bg-slate-800 p-4 rounded-xl text-[10px] font-black uppercase italic">Edit</button>
                            </div>
                        </div>
                    ))}
                    <button onClick={onCreate} className="w-full bg-white/5 border border-white/10 py-6 rounded-full font-black uppercase italic">➕ NUEVA RUTINA</button>
                </div>
            );
        }

        // --- Create/Edit Workout View Component ---
        function CreateView({ user, workoutToEdit, onCancel }) {
            // Deep merge default parameters with existing workoutToEdit phases
            const initialPhases = workoutToEdit?.phases
                ? {
                    ...DEFAULT_PARAMS, // Start with all defaults
                    ...workoutToEdit.phases, // Override top-level keys
                    entrenamiento: { // Deep merge for 'entrenamiento'
                        ...DEFAULT_PARAMS.entrenamiento,
                        ...(workoutToEdit.phases.entrenamiento || {})
                    }
                }
                : DEFAULT_PARAMS;

            const [name, setName] = useState(workoutToEdit?.name || '');
            const [phases, setPhases] = useState(initialPhases);
            const [saving, setSaving] = useState(false);

            const update = (p, f, v) => setPhases(prev => ({...prev, [p]: {...prev[p], [f]: parseInt(v)||0}}));
            
            const save = async () => {
                if (!name.trim() || saving) return; 
                setSaving(true);
                try {
                    const col = db.collection('artifacts').doc(APP_ID).collection('users').doc(user.uid).collection('workouts');
                    
                    // Ensure all fields are present for saving, even if not explicitly touched by user
                    const dataToSave = { 
                        name: name.toUpperCase(), 
                        phases: {
                            ...DEFAULT_PARAMS, 
                            ...phases, 
                            entrenamiento: { 
                                ...DEFAULT_PARAMS.entrenamiento,
                                ...phases.entrenamiento
                            }
                        },
                        updatedAt: new Date().toISOString() 
                    };

                    if (workoutToEdit?.id) {
                        await col.doc(workoutToEdit.id).update(dataToSave); 
                    } else {
                        await col.add({ ...dataToSave, createdAt: new Date().toISOString() });
                    }
                    onCancel();
                } catch(e) { 
                    alert("Error al guardar: " + e.message); 
                    setSaving(false); 
                }
            };

            const ENT_FIELDS = [
                {f:'action',label:'Acción (s)'},
                {f:'change',label:'Cambio (s)'},
                {f:'rounds',label:'Rondas'},
                {f:'cycles',label:'Ciclos'},
                {f:'rest',label:'Descanso Ciclo (s)'},
                {f:'zoneRest',label:'Descanso Zona (s)'}
            ];

            const STRETCH_FIELDS = [
                {f:'stretchSteps', label:'Pasos Estiramiento'},
                {f:'stretchAction', label:'Duración Estir. (s)'},
                {f:'stretchChange', label:'Cambio Estir. (s)'}
            ];

            return (
                <div className="flex-1 flex flex-col bg-slate-950 overflow-hidden text-center italic">
                    <header className="p-6 flex items-center border-b border-white/5 shrink-0">
                        <button onClick={onCancel} className="p-3 bg-slate-900 rounded-2xl shadow-lg text-white">⬅</button>
                        <h2 className="text-xl font-black uppercase flex-1">Configurar</h2>
                    </header>
                    <div className="flex-1 overflow-y-auto scrollbar-hide p-4 space-y-6 pb-28">
                        <input type="text" placeholder="NOMBRE DE LA RUTINA" className="w-full p-6 bg-slate-900 border border-white/10 rounded-[2rem] font-black uppercase text-center text-white outline-none" value={name} onChange={e=>setName(e.target.value)} />
                        
                        <div className="glass-card p-6 space-y-4">
                            <span className="font-black uppercase text-xs text-orange-500 border-b border-white/5 block pb-2">Entrenamiento</span>
                            <div className="grid grid-cols-2 gap-4">
                                {ENT_FIELDS.map(({f,label}) => <InputField key={f} label={label} val={(phases.entrenamiento?.[f] ?? DEFAULT_PARAMS.entrenamiento[f])} set={v=>update('entrenamiento',f,v)} />)}
                            </div>
                        </div>

                        <div className="glass-card p-6 space-y-4">
                            <span className="font-black uppercase text-xs text-orange-500 border-b border-white/5 block pb-2">Estiramientos</span>
                            <div className="grid grid-cols-2 gap-4">
                                {STRETCH_FIELDS.map(({f,label}) => <InputField key={f} label={label} val={(phases.entrenamiento?.[f] ?? DEFAULT_PARAMS.entrenamiento[f])} set={v=>update('entrenamiento',f,v)} />)}
                            </div>
                        </div>
                    </div>
                    <div className="p-6 bg-slate-950 border-t border-white/5 shrink-0">
                        <button onClick={save} className="w-full bg-white text-black py-6 rounded-full font-black uppercase" disabled={saving}>
                            {saving ? 'GUARDANDO...' : 'GUARDAR'}
                        </button>
                    </div>
                </div>
            );
        }

        // --- Generic Input Field Component ---
        function InputField({ label, val, set }) { 
            return ( 
                <div className="flex flex-col items-center"> 
                    <span className="text-[8px] opacity-40 mb-2 uppercase">{label}</span> 
                    <input type="number" className="w-full bg-slate-800/40 p-4 rounded-xl text-center font-black text-white border border-white/5 outline-none" value={val} onChange={e=>set(e.target.value)} /> 
                </div> 
            ); 
        }

        // --- Workout Player View Component ---
        function PlayerView({ workout, onExit, onComplete }) {
            const [status, setStatus] = useState('ready'); 
            const [idx, setIdx] = useState(0);
            const [timeLeft, setTimeLeft] = useState(0);
            const [elapsed, setElapsed] = useState(0);
            const [steps, setSteps] = useState([]);
            const [wasPausedByHide, setWasPausedByHide] = useState(false);

            const lastSpokenKey = useRef('');
            const savedRef = useRef(false);
            const wakeLockRef = useRef(null);
            const videoRef = useRef(null); // Used for wake lock workaround
            const startRef = useRef(null); // Total elapsed time tracking
            const stepStartRef = useRef(null); // Time tracking for current step
            const stepDurRef = useRef(0); // Duration of current step
            const firstPlayDone = useRef(false); // Flag for initial "Prepárate" announcement

            // --- Wake Lock Management ---
            const requestStayAwake = async () => {
                // Workaround for iOS/some browsers: play a silent video
                if (videoRef.current && status === 'running') {
                    videoRef.current.play().catch(()=>{});
                }
                // Request Screen Wake Lock API
                try { 
                    if ('wakeLock' in navigator && !wakeLockRef.current) {
                        wakeLockRef.current = await navigator.wakeLock.request('screen'); 
                    }
                } catch(e){ console.warn("Wake Lock API failed:", e); }
            };
            const releaseStayAwake = () => {
                if (videoRef.current) videoRef.current.pause();
                if (wakeLockRef.current) { 
                    wakeLockRef.current.release(); 
                    wakeLockRef.current = null; 
                }
            };

            // Handle visibility change to pause/resume workout and wake lock
            useEffect(() => {
                const handleVisibilityChange = () => {
                    if (document.hidden) { 
                        if (status === 'running') { setStatus('paused'); setWasPausedByHide(true); }
                        releaseStayAwake(); 
                    } else { 
                        if ('wakeLock' in navigator) requestStayAwake(); 
                        // If it was paused by hide, unpause it
                        if (wasPausedByHide) { setStatus('running'); setWasPausedByHide(false); }
                    }
                };
                document.addEventListener('visibilitychange', handleVisibilityChange);
                return () => document.removeEventListener('visibilitychange', handleVisibilityChange);
            }, [status, wasPausedByHide]);

            // Request/release wake lock based on status
            useEffect(() => {
                if (status === 'running') requestStayAwake(); else releaseStayAwake();
                return () => releaseStayAwake(); // Cleanup on unmount or status change
            }, [status]);

            // --- Step Generation ---
            useEffect(() => {
                if (!workout) return;
                const ent = { 
                    ...DEFAULT_PARAMS.entrenamiento, 
                    ...(workout.phases?.entrenamiento || {})
                };
                const s = [];

                // 1. Inicio - Prepárate
                s.push({ 
                    label:'PREPÁRATE', seconds:15, color:'bg-yellow-400', phase:'inicio',
                    voiceInitial: 'Prepárate para el calentamiento',
                    whistleOnStart: false,
                    voiceCountdown: true
                });

                // 2. Calentamiento
                WARMUP_STEPS.forEach((ws, i) => {
                    s.push({ 
                        label: ws.label, seconds: 30, color: 'bg-yellow-400', phase: 'calentamiento',
                        voiceInitial: ws.voice || ws.label.toLowerCase(),
                        whistleOnStart: true,
                        voiceCountdown: true
                    });
                    if (i < WARMUP_STEPS.length - 1) {
                        s.push({ 
                            label: 'CAMBIO', seconds: 5, color: 'bg-yellow-300', phase: 'cambio-warmup', 
                            voiceInitial: 'Cambio', voiceMidpoint: { time: 2, text: WARMUP_STEPS[i+1].voice },
                            whistleOnStart: false,
                            voiceCountdown: true
                        });
                    }
                });
                s.push({ 
                    label:'DESCANSO', seconds:20, color:'bg-rose-400', phase:'post-warmup',
                    voiceInitial: 'Descanso. A continuación, el entrenamiento principal. Piernas.',
                    whistleOnStart: false,
                    voiceCountdown: true
                });

                // 3. Entrenamiento por ciclos y zonas
                for (let cy = 1; cy <= ent.cycles; cy++) {
                    TRAINING_ZONES.forEach((zone, zi) => {
                        for (let r = 1; r <= ent.rounds; r++) {
                            s.push({ 
                                label: zone, seconds: ent.action, color: 'bg-emerald-400', phase: 'entrenamiento', 
                                r, tr: ent.rounds, cy, tc: ent.cycles,
                                voiceInitial: zone.toLowerCase(),
                                whistleOnStart: true,
                                voiceCountdown: true
                            });
                            if (r < ent.rounds) {
                                s.push({ 
                                    label: 'CAMBIO', seconds: ent.change, color: 'bg-yellow-300', phase: 'cambio-ent',
                                    voiceInitial: 'Cambio', voiceMidpoint: { time: 2, text: `Siguiente: ${zone.toLowerCase()}` },
                                    whistleOnStart: false,
                                    voiceCountdown: true
                                });
                            }
                        }
                        if (zi < TRAINING_ZONES.length - 1) {
                            s.push({ 
                                label: 'DESCANSO', seconds: ent.zoneRest, color: 'bg-sky-500', phase: 'zone-rest',
                                voiceInitial: 'Descanso de zona', voiceMidpoint: { time: 10, text: `Siguiente zona: ${TRAINING_ZONES[zi+1].toLowerCase()}` },
                                whistleOnStart: false,
                                voiceCountdown: true
                            });
                        }
                    });
                    if (cy < ent.cycles) {
                        s.push({ 
                            label: 'DESCANSO', seconds: ent.rest, color: 'bg-rose-500', phase: 'ciclo-rest',
                            voiceInitial: `Descanso de ciclo. Queda ${ent.cycles - cy} ${ent.cycles - cy === 1 ? 'ciclo' : 'ciclos'}`, 
                            voiceMidpoint: { time: 10, text: 'Nuevo ciclo. Piernas.' },
                            whistleOnStart: false,
                            voiceCountdown: true
                        });
                    }
                }
                
                // 4. Estiramientos
                s.push({ 
                    label:'DESCANSO', seconds:30, color:'bg-blue-200', phase:'pre-stretches',
                    voiceInitial: 'Descanso. Prepárate para los estiramientos',
                    whistleOnStart: false,
                    voiceCountdown: true
                });
                for (let i = 0; i < ent.stretchSteps; i++) {
                    s.push({ 
                        label: `ESTIRAMIENTO ${i + 1}`, seconds: ent.stretchAction, color: 'bg-blue-400', phase: 'estiramientos',
                        voiceInitial: `Estiramiento ${i + 1}`,
                        whistleOnStart: true,
                        voiceCountdown: true
                    });
                    if (i < ent.stretchSteps - 1) {
                        s.push({ 
                            label: 'CAMBIO', seconds: ent.stretchChange, color: 'bg-blue-200', phase: 'cambio-est',
                            voiceInitial: 'Cambio', voiceMidpoint: { time: 2, text: `Siguiente estiramiento` },
                            whistleOnStart: false,
                            voiceCountdown: true
                        });
                    }
                }
                setSteps(s); 
                if (s.length > 0) {
                    setTimeLeft(s[0].seconds); 
                    stepDurRef.current = s[0].seconds;
                }
            }, [workout]);

            // --- Centralized Speech Handler ---
            const handleSpeech = (step, remaining) => {
                if (!step) return;

                const vKey = `${idx}_${remaining}`;
                if (lastSpokenKey.current === vKey) return; // Prevent duplicate speech in same interval
                lastSpokenKey.current = vKey;

                // Initial announcement for the step
                if (remaining === step.seconds) {
                    speak(step.voiceInitial, true); // Interrupt previous speech and announce new step
                    if (step.whistleOnStart) whistle();
                    if ('vibrate' in navigator) navigator.vibrate(150); // Vibrate at start of step
                }

                // Midpoint announcements
                if (step.voiceMidpoint && remaining === step.voiceMidpoint.time) {
                    speak(step.voiceMidpoint.text);
                }

                // Countdown (only for last 3 seconds)
                if (step.voiceCountdown && remaining > 0 && remaining <= 3) {
                    speak(String(remaining));
                }
            };

            // --- Toggle Play/Pause ---
            const togglePlay = () => {
                if (!firstPlayDone.current) {
                    firstPlayDone.current = true;
                    setWasPausedByHide(false);
                    // Initial "Prepárate" announcement, timer starts after it finishes
                    speak('Prepárate para empezar', true, () => setStatus('running'));
                } else {
                    setStatus(prev => prev === 'running' ? 'paused' : 'running');
                    setWasPausedByHide(false);
                }
            };

            // --- Timer Logic ---
            useEffect(() => {
                let interval = null;
                if (status === 'running') {
                    if (!startRef.current) startRef.current = Date.now() - (elapsed * 1000);
                    if (!stepStartRef.current) stepStartRef.current = Date.now() - ((stepDurRef.current - timeLeft) * 1000);
                    
                    interval = setInterval(() => {
                        const now = Date.now();
                        const totalSec = Math.floor((now - startRef.current) / 1000); 
                        setElapsed(totalSec);
                        
                        const stepPassed = Math.floor((now - stepStartRef.current) / 1000);
                        const remaining = stepDurRef.current - stepPassed;

                        if (remaining > 0) {
                            setTimeLeft(remaining);
                            handleSpeech(steps[idx], remaining); // Centralized speech handler
                        } else {
                            // Move to next step or finish
                            if (idx < steps.length - 1) {
                                const n = idx + 1; 
                                setIdx(n); 
                                setTimeLeft(steps[n].seconds);
                                stepDurRef.current = steps[n].seconds; 
                                stepStartRef.current = Date.now(); 
                                lastSpokenKey.current = ''; // Reset for new step
                            } else {
                                setStatus('finished'); 
                                speak('¡Excelente trabajo! Rutina completada.');
                                if (!savedRef.current) { 
                                    onComplete(workout.name, totalSec); 
                                    savedRef.current = true; 
                                }
                            }
                        }
                    }, 250); // Update every 250ms for smoother countdown
                } else { 
                    startRef.current = null; 
                    stepStartRef.current = null; 
                }
                return () => clearInterval(interval);
            }, [status, idx, steps, timeLeft, elapsed, workout, onComplete]); // Added workout and onComplete to deps

            // --- Render Logic ---
            if (status === 'finished') return (
                <div className="h-screen flex flex-col items-center justify-center p-8 bg-slate-950 text-white text-center">
                    <h1 className="text-5xl font-black italic mb-4">¡HECHO!</h1>
                    <button onClick={onExit} className="w-full max-w-sm bg-white text-black py-6 rounded-full font-black uppercase">Finalizar</button>
                </div>
            );

            const curr = steps[idx];
            return (
                <div className={`h-screen flex flex-col transition-colors duration-700 ${curr?.color || 'bg-slate-950'} text-white`}>
                    {/* Silent video for iOS wake lock workaround */}
                    <video ref={videoRef} loop muted playsInline style={{position:'absolute',width:'1px',height:'1px',opacity:0.01}}><source src="https://raw.githubusercontent.com/intel-iot-devkit/sample-videos/master/one-second-loop.mp4" type="video/mp4"/></video>
                    
                    <div className="bg-black/10 p-4 pt-10 flex justify-between items-center shrink-0 z-10">
                        <div className="leading-none text-left">
                            <span className="text-[10px] font-black text-orange-500 uppercase">Tiempo Total</span>
                            <p className="text-xl font-black italic">{formatTime(elapsed)}</p>
                        </div>
                        <div className="text-center">
                            <h2 className="text-[10px] font-black uppercase italic truncate max-w-[120px] tracking-tight">{workout?.name || 'Rutina'}</h2>
                        </div>
                        <button onClick={onExit} className="opacity-40 text-xl font-black px-2">✕</button>
                    </div>

                    <div className="flex-1 flex flex-col items-center justify-center text-center px-4 min-h-0 relative">
                        {status === 'ready' || (wasPausedByHide && status === 'paused') ? (
                            <div className="absolute inset-0 z-40 bg-slate-950/40 backdrop-blur-sm flex items-center justify-center">
                                <button onClick={togglePlay} className="bg-orange-500 p-10 rounded-full shadow-2xl active:scale-90"><IconPlay/></button>
                            </div>
                        ) : null}
                        <h2 className="text-[11vw] font-black uppercase italic text-white/80 leading-none mb-2">{curr?.label || 'LISTO'}</h2>
                        <div className="timer-huge tabular-nums text-white">{timeLeft}</div>
                    </div>

                    <div className="bg-slate-950 p-6 pb-10 flex flex-col items-center shrink-0">
                        <div className="w-full max-w-md grid grid-cols-3 items-center mb-6 text-center italic">
                            <div className="flex flex-col">
                                <span className="text-[14vw] font-black text-sky-400 leading-none">{curr?.tr ? curr.tr - (curr.r||0) + 1 : '-'}</span>
                                <span className="text-[8px] opacity-40">Rondas Restantes</span>
                            </div>
                            <div className="flex justify-center">
                                <button onClick={togglePlay} className="w-20 h-20 rounded-full border-4 border-yellow-400 flex items-center justify-center active:scale-90">
                                    {status === 'running' ? <IconPause/> : <IconPlay/>}
                                </button>
                            </div>
                            <div className="flex flex-col">
                                <span className="text-[14vw] font-black text-yellow-400 leading-none">{curr?.tc ? curr.tc - (curr.cy||0) + 1 : '-'}</span>
                                <span className="text-[8px] opacity-40">Ciclos Restantes</span>
                            </div>
                        </div>
                    </div>
                </div>
            );
        }

        // --- Avance/History View Component ---
        function AvanceView({ history }) {
            const [periodType, setPeriodType] = useState('semana'); // 'semana', 'mes', 'año'
            const [periodOffset, setPeriodOffset] = useState(0); // 0: actual, -1: anterior, etc.

            const chartRef = useRef(null);
            const chartInst = useRef(null);
            const totalSec = history.reduce((a, h) => a + (h.totalTime || 0), 0);

            // --- Helper Functions for Date Ranges ---
            const startOfDay = (date) => {
                const d = new Date(date);
                d.setHours(0, 0, 0, 0);
                return d;
            };

            const endOfDay = (date) => {
                const d = new Date(date);
                d.setHours(23, 59, 59, 999);
                return d;
            };

            // Returns { start: Date, end: Date } for a week (Monday-Sunday)
            const getWeekRange = (date, offset = 0) => {
                const d = startOfDay(date);
                d.setDate(d.getDate() + offset * 7); // Apply week offset
                const day = d.getDay(); // 0 for Sunday, 1 for Monday, ..., 6 for Saturday
                // Calculate the difference to get to Monday (if day is Sunday, it's 6 days back for previous week Monday).
                // Otherwise, it's (day - 1) days back to this week's Monday.
                const diff = d.getDate() - day + (day === 0 ? -6 : 1); 
                const start = startOfDay(new Date(d.setDate(diff)));
                const end = endOfDay(new Date(d.setDate(diff + 6)));
                return { start, end };
            };

            // Returns { start: Date, end: Date } for a month
            const getMonthRange = (date, offset = 0) => {
                const d = startOfDay(date);
                d.setMonth(d.getMonth() + offset);
                const start = startOfDay(new Date(d.getFullYear(), d.getMonth(), 1));
                const end = endOfDay(new Date(d.getFullYear(), d.getMonth() + 1, 0)); // Last day of month
                return { start, end };
            };

            // Returns { start: Date, end: Date } for a year
            const getYearRange = (date, offset = 0) => {
                const d = startOfDay(date);
                d.setFullYear(d.getFullYear() + offset);
                const start = startOfDay(new Date(d.getFullYear(), 0, 1));
                const end = endOfDay(new Date(d.getFullYear(), 11, 31));
                return { start, end };
            };
            // --- End Helper Functions ---


            // Calculate current period range based on type and offset
            const currentPeriodRange = (() => {
                const today = new Date();
                if (periodType === 'semana') return getWeekRange(today, periodOffset);
                if (periodType === 'mes') return getMonthRange(today, periodOffset);
                if (periodType === 'año') return getYearRange(today, periodOffset);
                return { start: new Date(0), end: new Date() }; // Default empty range
            })();

            // Filter history for the current selected period
            const filteredHistory = history.filter(h => {
                const hDate = new Date(h.date);
                return hDate >= currentPeriodRange.start && hDate <= currentPeriodRange.end;
            });

            const periodSec = filteredHistory.reduce((a, h) => a + (h.totalTime || 0), 0);


            useEffect(() => {
                const ctx = chartRef.current?.getContext('2d');
                if (!ctx) return;
                if (chartInst.current) chartInst.current.destroy();

                let labels = [];
                let data = [];
                const aggregationMap = new Map(); // Key: label, Value: totalTime (seconds)

                if (periodType === 'semana') {
                    // Labels for each day of the week
                    for (let d = new Date(currentPeriodRange.start); d <= currentPeriodRange.end; d.setDate(d.getDate() + 1)) {
                        labels.push(d.toLocaleDateString('es-ES', { weekday: 'short', day: 'numeric' }));
                    }
                    // Aggregate data by day
                    filteredHistory.forEach(h => {
                        const dateKey = new Date(h.date).toLocaleDateString('es-ES', { weekday: 'short', day: 'numeric' });
                        aggregationMap.set(dateKey, (aggregationMap.get(dateKey) || 0) + (h.totalTime || 0));
                    });
                    data = labels.map(label => Math.floor((aggregationMap.get(label) || 0) / 60));

                } else if (periodType === 'mes') {
                    labels = []; data = [];
                    let weekCursor = new Date(currentPeriodRange.start);
                    // Ensure weekCursor starts on Monday of the first week that touches the month
                    weekCursor = startOfDay(new Date(weekCursor.setDate(weekCursor.getDate() - (weekCursor.getDay() === 0 ? 6 : weekCursor.getDay() - 1))));

                    let currentWeekNumber = 1;
                    while (weekCursor <= currentPeriodRange.end || (weekCursor.getMonth() === currentPeriodRange.end.getMonth() && weekCursor.getFullYear() === currentPeriodRange.end.getFullYear())) {
                        const weekRange = {
                            start: new Date(weekCursor),
                            end: endOfDay(new Date(weekCursor.getFullYear(), weekCursor.getMonth(), weekCursor.getDate() + 6))
                        };

                        const effectiveWeekStart = startOfDay(new Date(Math.max(weekRange.start.getTime(), currentPeriodRange.start.getTime())));
                        const effectiveWeekEnd = endOfDay(new Date(Math.min(weekRange.end.getTime(), currentPeriodRange.end.getTime())));
                        
                        if (effectiveWeekStart <= effectiveWeekEnd) {
                            labels.push(`Semana ${currentWeekNumber} (${effectiveWeekStart.getDate()}/${effectiveWeekStart.getMonth() + 1})`);
                            let weekTotalTime = 0;
                            filteredHistory.forEach(h => {
                                const hDate = new Date(h.date);
                                if (hDate >= effectiveWeekStart && hDate <= effectiveWeekEnd) {
                                    weekTotalTime += (h.totalTime || 0);
                                }
                            });
                            data.push(Math.floor(weekTotalTime / 60));
                            currentWeekNumber++; // Increment week number only if it's an "effective" week
                        }
                        
                        weekCursor.setDate(weekCursor.getDate() + 7);
                        // Stop if the week cursor has moved past the end of the month
                        if (weekCursor.getMonth() !== currentPeriodRange.start.getMonth() && weekCursor > currentPeriodRange.end) break;
                    }

                } else { // periodType === 'año'
                    // Labels for each month of the year
                    for (let i = 0; i < 12; i++) {
                        labels.push(new Date(currentPeriodRange.start.getFullYear(), i, 1).toLocaleDateString('es-ES', { month: 'short' }));
                    }
                    // Aggregate data by month
                    filteredHistory.forEach(h => {
                        const monthKey = new Date(h.date).toLocaleDateString('es-ES', { month: 'short' });
                        aggregationMap.set(monthKey, (aggregationMap.get(monthKey) || 0) + (h.totalTime || 0));
                    });
                    data = labels.map(label => Math.floor((aggregationMap.get(label) || 0) / 60));
                }

                chartInst.current = new Chart(ctx, {
                    type: 'bar',
                    data: { labels, datasets: [{ label: 'Minutos', data, backgroundColor: '#f97316', borderRadius: 8 }] },
                    options: {
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: {
                            y: { beginAtZero: true, grid: { color: 'rgba(255,255,255,0.05)' }, ticks: { color: '#64748b' } },
                            x: { grid: { display: false }, ticks: { color: '#64748b', font: { size: 10 } } }
                        }
                    }
                });
                return () => chartInst.current?.destroy();
            }, [history, periodType, periodOffset]); // Re-run effect when history or period changes


            const getPeriodTitle = () => {
                const { start, end } = currentPeriodRange;
                const startFormat = { day: 'numeric', month: 'short' };
                const endFormat = { day: 'numeric', month: 'short' };

                if (periodType === 'semana') {
                    // Check if start and end are in the same month
                    if (start.getMonth() === end.getMonth()) {
                        return `Semana: ${start.getDate()} - ${end.toLocaleDateString('es-ES', endFormat)}`;
                    } else {
                        return `Semana: ${start.toLocaleDateString('es-ES', startFormat)} - ${end.toLocaleDateString('es-ES', endFormat)}`;
                    }
                } else if (periodType === 'mes') {
                    return `Mes: ${start.toLocaleDateString('es-ES', { month: 'long', year: 'numeric' })}`;
                } else if (periodType === 'año') {
                    return `Año: ${start.getFullYear()}`;
                }
                return '';
            };

            return (
                <div className="flex-1 overflow-y-auto scrollbar-hide p-4 space-y-4 pb-28">
                    <div className="glass-card p-6 text-center">
                        <span className="text-[9px] opacity-40 block mb-1 uppercase">Tiempo Total Acumulado</span>
                        <span className="text-3xl font-black text-orange-500">{Math.floor(totalSec / 3600)}h {Math.floor((totalSec % 3600) / 60)}m</span>
                    </div>
                    
                    {/* Period Type Buttons */}
                    <div className="flex gap-2">
                        {['semana', 'mes', 'año'].map(p => (
                            <button key={p} onClick={() => { setPeriodType(p); setPeriodOffset(0); }}
                                className={`flex-1 py-3 rounded-xl font-black uppercase text-[10px] transition-all 
                                            ${periodType === p ? 'bg-orange-500 text-white' : 'bg-white/5 text-slate-400'}`}>
                                {p}
                            </button>
                        ))}
                    </div>

                    {/* Period Navigation */}
                    <div className="flex items-center justify-between glass-card p-4">
                        <button onClick={() => setPeriodOffset(prev => prev - 1)}
                                className="p-2 bg-white/5 text-slate-400 rounded-lg">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/></svg>
                        </button>
                        <span className="text-sm font-black uppercase italic text-orange-400">
                            {getPeriodTitle()}
                        </span>
                        <button onClick={() => setPeriodOffset(prev => prev + 1)}
                                disabled={periodOffset >= 0} // Disable if on current period
                                className={`p-2 rounded-lg ${periodOffset >= 0 ? 'bg-white/10 text-slate-600 cursor-not-allowed' : 'bg-white/5 text-slate-400'}`}>
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/></svg>
                        </button>
                    </div>

                    <div className="glass-card p-5 flex justify-between items-center">
                        <div className="text-left">
                            <span className="text-[9px] opacity-40 uppercase block">Tiempo en {periodType === 'semana' ? 'esta semana' : periodType === 'mes' ? 'este mes' : 'este año'}</span>
                            <span className="text-2xl font-black text-sky-400">{Math.floor(periodSec / 3600)}h {Math.floor((periodSec % 3600) / 60)}m</span>
                        </div>
                        <div className="text-right">
                            <span className="text-[9px] opacity-40 uppercase block">Sesiones</span>
                            <span className="text-2xl font-black text-emerald-400">{filteredHistory.length}</span>
                        </div>
                    </div>
                    <div className="glass-card p-4">
                        <div style={{ height: '200px' }}>
                            <canvas ref={chartRef} />
                        </div>
                    </div>
                </div>
            );
        }

        // --- Render Root Component ---
        ReactDOM.createRoot(document.getElementById('root')).render(<App />);
    </script>
</body>
</html>