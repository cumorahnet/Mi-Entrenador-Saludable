<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#020617">
    <title>Mi Entrenador Saludable</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
    <script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&display=swap');
        body {
            font-family: 'Inter', sans-serif; background-color: #020617; color: white;
            margin: 0; padding: 0; overflow: hidden; -webkit-tap-highlight-color: transparent;
            position: fixed; width: 100%; height: 100%;
        }
        #root { height: 100%; width: 100%; display: flex; flex-direction: column; }
        .glass-card {
            background: rgba(255,255,255,0.03); backdrop-filter: blur(10px);
            border: 1px solid rgba(255,255,255,0.05); border-radius: 1.5rem;
        }
        .scrollbar-hide::-webkit-scrollbar { display: none; }
        .timer-huge {
            font-size: 60vw; line-height: 0.75; font-weight: 900;
            letter-spacing: -0.06em; pointer-events: none;
        }
        @media (orientation: landscape) { .timer-huge { font-size: 75vh; } }
    </style>
</head>
<body>
    <div id="root"></div>

    <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-auth-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-firestore-compat.js"></script>

    <script>
        const { useState, useEffect, useRef, useCallback, useMemo } = React;

        const IconPlay = () => React.createElement('svg', { width: "40", height: "40", viewBox: "0 0 24 24", fill: "currentColor" }, React.createElement('path', { d: "M8 5v14l11-7z" }));
        const IconPause = () => React.createElement('svg', { width: "24", height: "24", viewBox: "0 0 24 24", fill: "currentColor" }, React.createElement('path', { d: "M6 19h4V5H6v14zm8-14v14h4V5h-4z" }));

        const firebaseConfig = {
            apiKey: "AIzaSyDg0nohFAprIYta3Z3IvFGms55PehyxGIM",
            authDomain: "entrenadorpersonal-4e69d.firebaseapp.com",
            projectId: "entrenadorpersonal-4e69d",
            storageBucket: "entrenadorpersonal-4e69d.firebasestorage.app",
            messagingSenderId: "198872357236",
            appId: "1:198872357236:web:c3cd2a7f5caff197847421"
        };
        if (!firebase.apps.length) firebase.initializeApp(firebaseConfig);
        const auth = firebase.auth();
        const db = firebase.firestore();

        const APP_ID = "mientrenador-v3";
        const APP_TITLE = "Mi Entrenador Saludable";
        const APP_VERSION = "1.0.3";

        const WARMUP_STEPS = [
            { label: 'TOBILLO DERECHO', voice: 'Tobillo derecho' },
            { label: 'TOBILLO IZQUIERDO', voice: 'Tobillo izquierdo' },
            { label: 'RODILLAS DERECHA', voice: 'Rodillas a la derecha' },
            { label: 'RODILLAS IZQUIERDA', voice: 'Rodillas a la izquierda' },
            { label: 'CINTURA DERECHA', voice: 'Cintura a la derecha' },
            { label: 'CINTURA IZQUIERDA', voice: 'Cintura a la izquierda' },
            { label: 'BRAZO DERECHO', voice: 'Brazo derecho' },
            { label: 'BRAZO IZQUIERDO', voice: 'Brazo izquierdo' },
            { label: 'CUELLO ADELANTE Y ATRÁS', voice: 'Cuello adelante y atrás' },
            { label: 'CUELLO DER. E IZQ.', voice: 'Cuello derecha e izquierda' },
        ];

        const TRAINING_ZONES = ['PIERNAS', 'BRAZOS', 'TRONCO'];
        const DEFAULT_PARAMS = {
            entrenamiento: {
                action: 30, change: 5, rounds: 3, cycles: 4, rest: 60, zoneRest: 30,
                stretchSteps: 16, stretchAction: 30, stretchChange: 10
            }
        };
        const formatTime = (s) => `${Math.floor(s / 60)}:${(s % 60).toString().padStart(2, '0')}`;

        // GPS specific phases
        const GPS_PHASE_KEY = 'gps-tracking';
        const POST_GPS_REST_PHASE_KEY = 'post-gps-rest';

        // ─── GPS Utility Functions ──────────────────────────────────────────────────
        const getDistance = (lat1, lon1, lat2, lon2) => {
            const R = 6371e3; // metres
            const φ1 = lat1 * Math.PI/180;
            const φ2 = lat2 * Math.PI/180;
            const Δφ = (lat2-lat1) * Math.PI/180;
            const Δλ = (lon2-lon1) * Math.PI/180;

            const a = Math.sin(Δφ/2) * Math.sin(Δφ/2) +
                      Math.cos(φ1) * Math.cos(φ2) *
                      Math.sin(Δλ/2) * Math.sin(Δλ/2);
            const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));

            return R * c; // in metres
        };

        const formatPace = (totalDistanceMeters, totalTimeSeconds) => {
            if (totalDistanceMeters <= 0 || totalTimeSeconds <= 0) return '0:00';
            const paceSecondsPerKm = (totalTimeSeconds / (totalDistanceMeters / 1000));
            const minutes = Math.floor(paceSecondsPerKm / 60);
            const seconds = Math.round(paceSecondsPerKm % 60);
            return `${minutes}:${seconds.toString().padStart(2, '0')}`;
        };

        const formatDistance = (meters) => {
            if (meters < 1000) return `${Math.round(meters)} m`;
            return `${(meters / 1000).toFixed(2)} km`;
        };

        const formatSpeed = (meters, seconds) => {
            if (meters <= 0 || seconds <= 0) return '0.0 km/h';
            const kmPerHour = (meters / 1000) / (seconds / 3600);
            return `${kmPerHour.toFixed(1)} km/h`;
        };

        const whistle = () => {
            try {
                const ctx = new (window.AudioContext || window.webkitAudioContext)();
                const now = ctx.currentTime;
                const duration = 1.6;
                const createOsc = (freq, type = 'sine', vol = 1.0) => {
                    const osc = ctx.createOscillator();
                    const gain = ctx.createGain();
                    const mod = ctx.createOscillator();
                    const modGain = ctx.createGain();
                    osc.type = type;
                    osc.frequency.setValueAtTime(freq, now);
                    mod.frequency.setValueAtTime(45, now);
                    modGain.gain.setValueAtTime(freq * 0.1, now);
                    mod.connect(modGain); modGain.connect(osc.frequency);
                    osc.connect(gain); gain.connect(ctx.destination);
                    gain.gain.setValueAtTime(0, now);
                    gain.gain.linearRampToValueAtTime(vol, now + 0.05);
                    gain.gain.exponentialRampToValueAtTime(0.01, now + duration);
                    osc.start(now); mod.start(now);
                    osc.stop(now + duration); mod.stop(now + duration);
                };
                createOsc(3500); createOsc(3515, 'triangle', 0.5);
            } catch (e) { console.warn("Whistle failed:", e); }
        };

        const voiceQueue = [];
        let voiceBusy = false;
        const flushVoice = () => {
            if (voiceBusy || voiceQueue.length === 0 || !window.speechSynthesis) return;
            voiceBusy = true;
            const item = voiceQueue.shift();
            const text = typeof item === 'string' ? item : item.text;
            const onEndCallback = typeof item === 'object' && item.onEnd ? item.onEnd : () => {};
            const msg = new SpeechSynthesisUtterance(text);
            msg.lang = 'es-ES'; msg.rate = 1.05;
            msg.onend = msg.onerror = () => { voiceBusy = false; onEndCallback(); flushVoice(); };
            window.speechSynthesis.speak(msg);
        };
        const speak = (text, interrupt = false, onEnd = null) => {
            if (!window.speechSynthesis) return;
            if (interrupt) { window.speechSynthesis.cancel(); voiceQueue.length = 0; voiceBusy = false; }
            if (text) voiceQueue.push(onEnd ? { text, onEnd } : text);
            flushVoice();
        };

        const startOfDay = (date) => { const d = new Date(date); d.setHours(0, 0, 0, 0); return d; };
        const endOfDay = (date) => { const d = new Date(date); d.setHours(23, 59, 59, 999); return d; };
        const getWeekRange = (date, offset = 0) => {
            const d = startOfDay(new Date(date));
            d.setDate(d.getDate() + offset * 7);
            const day = d.getDay();
            const diff = d.getDate() - day + (day === 0 ? -6 : 1);
            const start = startOfDay(new Date(d.setDate(diff)));
            const end = endOfDay(new Date(d.setDate(diff + 6)));
            return { start, end };
        };
        const getMonthRange = (date, offset = 0) => {
            const d = startOfDay(new Date(date));
            d.setMonth(d.getMonth() + offset);
            const start = startOfDay(new Date(d.getFullYear(), d.getMonth(), 1));
            const end = endOfDay(new Date(d.getFullYear(), d.getMonth() + 1, 0));
            return { start, end };
        };
        const getYearRange = (date, offset = 0) => {
            const d = startOfDay(new Date(date));
            d.setFullYear(d.getFullYear() + offset);
            const start = startOfDay(new Date(d.getFullYear(), 0, 1));
            const end = endOfDay(new Date(d.getFullYear(), 11, 31));
            return { start, end };
        };

        // --- Helper functions for generating specific workout segments ---
        const generateWarmupSegment = (ent, nextPhaseIntro = null) => {
            const s = [];
            s.push({ label: 'PREPÁRATE', seconds: 15, color: 'bg-yellow-400', phase: 'inicio', voiceInitial: 'Prepárate para el calentamiento', whistleOnStart: false, voiceCountdown: true });
            WARMUP_STEPS.forEach((ws, i) => {
                s.push({ label: ws.label, seconds: 30, color: 'bg-yellow-400', phase: 'calentamiento', voiceInitial: ws.voice || ws.label.toLowerCase(), whistleOnStart: true, voiceCountdown: true });
                if (i < WARMUP_STEPS.length - 1) {
                    s.push({ label: 'CAMBIO', seconds: 5, color: 'bg-yellow-300', phase: 'cambio-warmup', voiceInitial: 'Cambio', voiceMidpoint: { time: 2, text: WARMUP_STEPS[i + 1].voice }, whistleOnStart: false, voiceCountdown: true });
                }
            });
            const transitionVoice = nextPhaseIntro ? ` ${nextPhaseIntro}` : '';
            s.push({ label: 'DESCANSO', seconds: 20, color: 'bg-rose-400', phase: 'post-warmup', voiceInitial: `Descanso.${transitionVoice}`, whistleOnStart: false, voiceCountdown: true });
            return s;
        };

        const generateMainTrainingSegment = (ent, nextPhaseIntro = null) => {
            const s = [];
            for (let cy = 1; cy <= ent.cycles; cy++) {
                TRAINING_ZONES.forEach((zone, zi) => {
                    for (let r = 1; r <= ent.rounds; r++) {
                        s.push({ label: zone, seconds: ent.action, color: 'bg-emerald-400', phase: 'entrenamiento', r, tr: ent.rounds, cy, tc: ent.cycles, voiceInitial: zone.toLowerCase(), whistleOnStart: true, voiceCountdown: true });
                        if (r < ent.rounds) {
                            s.push({ label: 'CAMBIO', seconds: ent.change, color: 'bg-yellow-300', phase: 'cambio-ent', voiceInitial: 'Cambio', voiceMidpoint: { time: 2, text: `Siguiente: ${zone.toLowerCase()}` }, whistleOnStart: false, voiceCountdown: true });
                        }
                    }
                    if (zi < TRAINING_ZONES.length - 1) {
                        s.push({ label: 'DESCANSO', seconds: ent.zoneRest, color: 'bg-sky-500', phase: 'zone-rest', voiceInitial: 'Descanso de zona', voiceMidpoint: { time: 10, text: `Siguiente zona: ${TRAINING_ZONES[zi + 1].toLowerCase()}` }, whistleOnStart: false, voiceCountdown: true });
                    }
                });
                if (cy < ent.cycles) {
                    s.push({ label: 'DESCANSO', seconds: ent.rest, color: 'bg-rose-500', phase: 'ciclo-rest', voiceInitial: `Descanso de ciclo. Queda ${ent.cycles - cy} ${ent.cycles - cy === 1 ? 'ciclo' : 'ciclos'}`, voiceMidpoint: { time: 10, text: 'Nuevo ciclo. Piernas.' }, whistleOnStart: false, voiceCountdown: true });
                }
            }
            const transitionVoice = nextPhaseIntro ? ` ${nextPhaseIntro}` : '';
            s.push({ label: 'DESCANSO', seconds: 30, color: 'bg-rose-400', phase: 'post-training', voiceInitial: `Descanso.${transitionVoice}`, whistleOnStart: false, voiceCountdown: true });
            return s;
        };

        const generateGpsRunSegment = (nextPhaseIntro = null) => {
            const s = [];
            s.push({ label: 'DESCANSO (PRE-GPS)', seconds: 20, color: 'bg-indigo-400', phase: 'pre-gps-rest', voiceInitial: `Descanso. Prepárate para iniciar tu caminata o carrera.`, whistleOnStart: false, voiceCountdown: true });
            s.push({ label: 'INICIAR CAMINATA O CARRERA', seconds: 1, color: 'bg-gray-800', phase: GPS_PHASE_KEY, voiceInitial: 'Iniciando seguimiento de caminata o carrera.', whistleOnStart: true, voiceCountdown: false });
            const transitionVoice = nextPhaseIntro ? ` ${nextPhaseIntro}` : '';
            s.push({ label: 'DESCANSO (POST-GPS)', seconds: 300, color: 'bg-teal-400', phase: POST_GPS_REST_PHASE_KEY, voiceInitial: `Descanso de 5 minutos.${transitionVoice}`, whistleOnStart: false, voiceCountdown: true });
            return s;
        };

        const generateStretchSegment = (ent, nextPhaseIntro = null) => {
            const s = [];
            s.push({ label: 'DESCANSO', seconds: 30, color: 'bg-blue-200', phase: 'pre-stretches', voiceInitial: 'Descanso. Prepárate para los estiramientos', whistleOnStart: false, voiceCountdown: true });
            for (let i = 0; i < ent.stretchSteps; i++) {
                s.push({ label: `ESTIRAMIENTO ${i + 1}`, seconds: ent.stretchAction, color: 'bg-blue-400', phase: 'estiramientos', voiceInitial: `Estiramiento ${i + 1}`, whistleOnStart: true, voiceCountdown: true });
                if (i < ent.stretchSteps - 1) {
                    s.push({ label: 'CAMBIO', seconds: ent.stretchChange, color: 'bg-blue-200', phase: 'cambio-est', voiceInitial: 'Cambio', voiceMidpoint: { time: 2, text: `Siguiente estiramiento` }, whistleOnStart: false, voiceCountdown: true });
                }
            }
            const lastStepOfStretch = s[s.length -1];
            if (lastStepOfStretch && nextPhaseIntro) {
                lastStepOfStretch.voiceInitial += ` ${nextPhaseIntro}`;
            }
            return s;
        };

        // Define all possible segments with their keys, labels, and generator functions
        const ALL_POSSIBLE_SEGMENTS_DATA = [
            { key: 'warmup', label: 'Calentamiento', generator: generateWarmupSegment },
            { key: 'training', label: 'Ejercicio Principal', generator: generateMainTrainingSegment },
            { key: 'run', label: 'Caminata o Carrera (GPS)', generator: generateGpsRunSegment },
            { key: 'stretch', label: 'Estiramientos', generator: generateStretchSegment },
        ];
        // The order of these keys defines the overall flow of the workout
        const ALL_POSSIBLE_SEGMENTS_ORDERED_KEYS = ALL_POSSIBLE_SEGMENTS_DATA.map(s => s.key);


        const generateWorkoutSteps = (workout, defaultParams, selectedPhasesKeys) => {
            if (!workout || !selectedPhasesKeys || selectedPhasesKeys.length === 0) return [];
            const ent = { ...defaultParams.entrenamiento, ...(workout.phases?.entrenamiento || {}) };
            let steps = [];

            // Filter and order the selected phases based on ALL_POSSIBLE_SEGMENTS_ORDERED_KEYS
            const activeSegments = ALL_POSSIBLE_SEGMENTS_DATA.filter(segment =>
                selectedPhasesKeys.includes(segment.key)
            ).sort((a, b) => ALL_POSSIBLE_SEGMENTS_ORDERED_KEYS.indexOf(a.key) - ALL_POSSIBLE_SEGMENTS_ORDERED_KEYS.indexOf(b.key));

            // Determine if an initial 'PREPÁRATE' is needed
            // If the first selected segment is NOT 'warmup', we need a general 'PREPÁRATE'
            if (activeSegments.length > 0 && activeSegments[0].key !== 'warmup') {
                let initialVoice = 'Prepárate para tu rutina.';
                if (activeSegments[0].key === 'training') initialVoice = 'Prepárate para el entrenamiento principal.';
                else if (activeSegments[0].key === 'run') initialVoice = 'Prepárate para tu caminata o carrera.';
                else if (activeSegments[0].key === 'stretch') initialVoice = 'Prepárate para los estiramientos.';
                steps.push({ label: 'PREPÁRATE', seconds: 15, color: 'bg-yellow-400', phase: 'inicio', voiceInitial: initialVoice, whistleOnStart: false, voiceCountdown: true });
            }

            for (let i = 0; i < activeSegments.length; i++) {
                const currentSegmentData = activeSegments[i];
                const nextSegmentData = activeSegments[i + 1];
                let introForNextInternalSegment = null; // Intro message for the *next* segment if it exists

                if (nextSegmentData) {
                    introForNextInternalSegment = `A continuación, ${nextSegmentData.label.toLowerCase()}.`;
                } else {
                    // This is the last actual activity segment before the final "Workout Completed" message
                    introForNextInternalSegment = 'Entrenamiento completado.';
                }

                // Call the generator for the current segment, passing the workout parameters and next phase intro
                // The `generateGpsRunSegment` only needs `nextPhaseIntro`
                if (currentSegmentData.key === 'run') {
                    steps = steps.concat(currentSegmentData.generator(introForNextInternalSegment));
                } else {
                    steps = steps.concat(currentSegmentData.generator(ent, introForNextInternalSegment));
                }
            }

            // Add the final overall completion step
            steps.push({ label: 'FINAL DE LA RUTINA', seconds: 10, color: 'bg-green-500', phase: 'finished', voiceInitial: 'Rutina finalizada. ¡Buen trabajo!', whistleOnStart: false, voiceCountdown: false });

            return steps;
        };


        // ─── ModeSelectionScreen Component ──────────────────────────────────────────────
        function ModeSelectionScreen({ onModeSelected, onCancel }) {
            const [selectedPhases, setSelectedPhases] = useState([]);

            const togglePhase = (phaseKey) => {
                setSelectedPhases(prev =>
                    prev.includes(phaseKey)
                        ? prev.filter(key => key !== phaseKey)
                        : [...prev, phaseKey]
                );
            };

            const handleStart = () => {
                if (selectedPhases.length === 0) {
                    speak('Por favor, selecciona al menos una fase de entrenamiento.', true);
                    return;
                }
                onModeSelected(selectedPhases);
            };

            return React.createElement('div', { className: "h-screen flex flex-col items-center justify-center bg-slate-950 p-8 text-white text-center" },
                React.createElement('h1', { className: "text-4xl font-black italic mb-6 text-orange-500" }, "Configura tu Sesión"),
                React.createElement('p', { className: "text-sm text-slate-400 mb-8" }, "Elige las fases de entrenamiento que deseas realizar:"),
                React.createElement('div', { className: "flex flex-col space-y-4 w-full max-w-sm mb-10" },
                    ALL_POSSIBLE_SEGMENTS_DATA.map(phase => // Use the ordered list for rendering checkboxes
                        React.createElement('label', { key: phase.key, className: "flex items-center p-4 glass-card cursor-pointer" },
                            React.createElement('input', {
                                type: "checkbox",
                                checked: selectedPhases.includes(phase.key),
                                onChange: () => togglePhase(phase.key),
                                className: "form-checkbox h-5 w-5 text-orange-500 rounded border-gray-300 mr-4 focus:ring-orange-500"
                            }),
                            React.createElement('span', { className: "text-lg font-bold italic flex-1 text-left" }, phase.label)
                        )
                    )
                ),
                React.createElement('button', {
                    onClick: handleStart,
                    className: "w-full max-w-sm bg-orange-500 py-6 rounded-full font-black uppercase text-white active:scale-95 italic"
                }, "INICIAR ENTRENAMIENTO"),
                React.createElement('button', {
                    onClick: onCancel,
                    className: "mt-4 w-full max-w-sm bg-white/10 text-white py-4 rounded-full font-black uppercase active:scale-95 italic text-xs"
                }, "Cancelar")
            );
        }

        // ─── App ────────────────────────────────────────────────────────────────────
        function App() {
            const [user, setUser] = useState(null);
            const [view, setView] = useState('workouts');
            const [workouts, setWorkouts] = useState([]);
            const [history, setHistory] = useState([]);
            const [loading, setLoading] = useState(true);
            const [selectedWorkout, setSelectedWorkout] = useState(null);

            useEffect(() => {
                const unsub = auth.onAuthStateChanged(u => {
                    setUser(u && !u.isAnonymous ? u : null);
                    setTimeout(() => setLoading(false), 500);
                });
                return unsub;
            }, []);

            useEffect(() => {
                if (!user) return;
                const base = db.collection('artifacts').doc(APP_ID).collection('users').doc(user.uid);
                const unsubW = base.collection('workouts').onSnapshot(s => setWorkouts(s.docs.map(d => ({ id: d.id, ...d.data() }))));
                const unsubH = base.collection('history').onSnapshot(s => setHistory(s.docs.map(d => ({ id: d.id, ...d.data() }))));
                return () => { unsubW(); unsubH(); };
            }, [user]);

            const handleStartWorkout = useCallback((w) => {
                if (window.speechSynthesis) {
                    const silent = new SpeechSynthesisUtterance(' ');
                    silent.volume = 0;
                    window.speechSynthesis.speak(silent);
                }
                setSelectedWorkout(w);
                setView('play');
            }, []);

            if (loading) return React.createElement('div', { className: "h-full w-full flex items-center justify-center bg-slate-950" }, React.createElement('div', { className: "animate-spin w-8 h-8 border-4 border-orange-500 border-t-transparent rounded-full" }));
            if (!user) return React.createElement(AuthView, { APP_TITLE, APP_VERSION });

            return React.createElement('div', { className: "h-full w-full flex flex-col bg-slate-950 text-white overflow-hidden" },
                view !== 'play' && React.createElement('header', { className: "p-5 flex justify-between items-center bg-slate-900 border-b border-white/5 shrink-0" },
                    React.createElement('div', { onClick: () => setView('workouts'), className: "cursor-pointer" },
                        React.createElement('h1', { className: "text-lg font-black italic uppercase text-orange-500" }, APP_TITLE),
                        React.createElement('p', { className: "text-[8px] text-slate-500 font-bold uppercase" }, user.email, " | V", APP_VERSION)
                    ),
                    React.createElement('button', { onClick: () => auth.signOut(), className: "p-2 bg-red-500/10 rounded-xl text-red-500 font-bold text-[10px] px-4 uppercase italic" }, "Salir")
                ),
                React.createElement('main', { className: "flex-1 relative flex flex-col min-h-0" },
                    view === 'workouts' && React.createElement(WorkoutsView, { workouts, user, onStart: handleStartWorkout, onEdit: w => { setSelectedWorkout(w); setView('create'); }, onCreate: () => { setSelectedWorkout(null); setView('create'); } } ),
                    view === 'avance'   && React.createElement(AvanceView, { history }),
                    view === 'create'   && React.createElement(CreateView, { user, workoutToEdit: selectedWorkout, onCancel: () => setView('workouts') }),
                    view === 'play'     && React.createElement(PlayerView, {
                        workout: selectedWorkout,
                        onExit: () => setView('workouts'),
                        onComplete: (name, time) => {
                            db.collection('artifacts').doc(APP_ID).collection('users').doc(user.uid)
                              .collection('history').add({ workoutName: name, totalTime: time, date: new Date().toISOString() });
                            setView('workouts');
                        }
                    })
                ),
                view !== 'play' && React.createElement('nav', { className: "bg-slate-900 border-t border-white/5 p-4 flex justify-around items-center shrink-0" },
                    React.createElement('button', { onClick: () => setView('workouts'), className: `flex flex-col items-center text-[9px] font-black ${view === 'workouts' ? 'text-orange-500' : 'text-slate-500'}` }, React.createElement('span', { className: "text-xl mb-1" }, "🏋️"), "RUTINAS"),
                    React.createElement('button', { onClick: () => setView('avance'),   className: `flex flex-col items-center text-[9px] font-black ${view === 'avance'   ? 'text-orange-500' : 'text-slate-500'}` }, React.createElement('span', { className: "text-xl mb-1" }, "📊"), "AVANCE")
                )
            );
        }

        // ─── AuthView ────────────────────────────────────────────────────────────────
        function AuthView({ APP_TITLE, APP_VERSION }) {
            const [isReg, setIsReg] = useState(false);
            const [email, setEmail] = useState('');
            const [pass, setPass] = useState('');
            const handle = useCallback(async e => {
                e.preventDefault();
                try {
                    if (isReg) await auth.createUserWithEmailAndPassword(email.trim(), pass);
                    else await auth.signInWithEmailAndPassword(email.trim(), pass);
                } catch (err) { alert("Error: " + err.message); }
            }, [isReg, email, pass]);
            return React.createElement('div', { className: "h-screen flex flex-col items-center bg-slate-950 p-10 pt-20 text-center" },
                React.createElement('div', { className: "text-7xl mb-6" }, "🏃‍♂️"),
                React.createElement('h1', { className: "text-4xl font-black italic uppercase text-white" }, APP_TITLE),
                React.createElement('p', { className: "text-[8px] text-slate-600 uppercase mb-8" }, "V ", APP_VERSION),
                React.createElement('form', { onSubmit: handle, className: "space-y-4 w-full max-w-sm" },
                    React.createElement('input', { type: "email", placeholder: "EMAIL", className: "w-full p-6 bg-slate-900 border border-white/5 rounded-[1.5rem] text-center text-white outline-none", value: email, onChange: e => setEmail(e.target.value), required: true }),
                    React.createElement('input', { type: "password", placeholder: "CLAVE", className: "w-full p-6 bg-slate-900 border border-white/5 rounded-[1.5rem] text-center text-white outline-none", value: pass, onChange: e => setPass(e.target.value), required: true }),
                    React.createElement('button', { type: "submit", className: "w-full bg-orange-500 py-6 rounded-full font-black uppercase text-white active:scale-95 italic" }, isReg ? 'REGISTRARSE' : 'ENTRAR')
                ),
                React.createElement('button', { onClick: () => setIsReg(!isReg), className: "mt-8 text-slate-500 text-[10px] uppercase font-black" }, isReg ? 'YA TENGO CUENTA' : 'CREAR CUENTA NUEVA')
            );
        }

        // ─── WorkoutsView ────────────────────────────────────────────────────────────
        function WorkoutsView({ workouts, user, onStart, onEdit, onCreate }) {
            return React.createElement('div', { className: "flex-1 overflow-y-auto scrollbar-hide p-4 space-y-4 pb-32" },
                workouts.length === 0
                    ? React.createElement('div', { className: "text-center p-12 opacity-30 italic font-black text-[10px]" }, "Sin rutinas")
                    : workouts.map(w => React.createElement('div', { key: w.id, className: "glass-card p-6 flex justify-between items-center shadow-lg" },
                        React.createElement('div', { className: "flex-1 cursor-pointer", onClick: () => onStart(w) },
                            React.createElement('h3', { className: "font-black uppercase italic text-sm" }, w.name),
                            React.createElement('span', { className: "text-[10px] text-orange-400 font-black uppercase italic" }, "Activa")
                        ),
                        React.createElement('div', { className: "flex gap-2" },
                            React.createElement('button', { onClick: () => onStart(w), className: "bg-white text-black p-4 rounded-xl" }, React.createElement(IconPlay, null)),
                            React.createElement('button', { onClick: () => onEdit(w), className: "bg-slate-800/40 p-4 rounded-xl text-[10px] font-black uppercase italic" }, "Edit")
                        )
                    )),
                React.createElement('button', { onClick: onCreate, className: "w-full bg-white/5 border border-white/10 py-6 rounded-full font-black uppercase italic" }, "➕ NUEVA RUTINA")
            );
        }

        // ─── CreateView ──────────────────────────────────────────────────────────────
        function CreateView({ user, workoutToEdit, onCancel }) {
            const initialPhases = workoutToEdit?.phases
                ? { ...DEFAULT_PARAMS, ...workoutToEdit.phases, entrenamiento: { ...DEFAULT_PARAMS.entrenamiento, ...(workoutToEdit.phases.entrenamiento || {}) } }
                : DEFAULT_PARAMS;
            const [name, setName] = useState(workoutToEdit?.name || '');
            const [phases, setPhases] = useState(initialPhases);
            const [saving, setSaving] = useState(false);
            const update = useCallback((p, f, v) => setPhases(prev => ({ ...prev, [p]: { ...prev[p], [f]: parseInt(v) || 0 } })), []);
            const save = useCallback(async () => {
                if (!name.trim() || saving) return;
                setSaving(true);
                try {
                    const col = db.collection('artifacts').doc(APP_ID).collection('users').doc(user.uid).collection('workouts');
                    const dataToSave = { name: name.toUpperCase(), phases: { ...DEFAULT_PARAMS, ...phases, entrenamiento: { ...DEFAULT_PARAMS.entrenamiento, ...phases.entrenamiento } }, updatedAt: new Date().toISOString() };
                    if (workoutToEdit?.id) await col.doc(workoutToEdit.id).update(dataToSave);
                    else await col.add({ ...dataToSave, createdAt: new Date().toISOString() });
                    onCancel();
                } catch (e) { alert("Error al guardar: " + e.message); setSaving(false); }
                }, [name, saving, phases, user, workoutToEdit, onCancel]);
            const ENT_FIELDS = [
                { f: 'action', label: 'Acción (s)' }, { f: 'change', label: 'Cambio (s)' },
                { f: 'rounds', label: 'Rondas' }, { f: 'cycles', label: 'Ciclos' },
                { f: 'rest', label: 'Descanso Ciclo (s)' }, { f: 'zoneRest', label: 'Descanso Zona (s)' }
            ];
            const STRETCH_FIELDS = [
                { f: 'stretchSteps', label: 'Pasos Estiramiento' },
                { f: 'stretchAction', label: 'Duración Estir. (s)' },
                { f: 'stretchChange', label: 'Cambio Estir. (s)' }
            ];
            return React.createElement('div', { className: "flex-1 flex flex-col bg-slate-950 overflow-hidden text-center italic" },
                React.createElement('header', { className: "p-6 flex items-center border-b border-white/5 shrink-0" },
                    React.createElement('button', { onClick: onCancel, className: "p-3 bg-slate-900 rounded-2xl shadow-lg text-white" }, "⬅"),
                    React.createElement('h2', { className: "text-xl font-black uppercase flex-1" }, "Configurar")
                ),
                React.createElement('div', { className: "flex-1 overflow-y-auto scrollbar-hide p-4 space-y-6 pb-28" },
                    React.createElement('input', { type: "text", placeholder: "NOMBRE DE LA RUTINA", className: "w-full p-6 bg-slate-900 border border-white/10 rounded-[2rem] font-black uppercase text-center text-white outline-none", value: name, onChange: e => setName(e.target.value) }),
                    React.createElement('div', { className: "glass-card p-6 space-y-4" },
                        React.createElement('span', { className: "font-black uppercase text-xs text-orange-500 border-b border-white/5 block pb-2" }, "Entrenamiento"),
                        React.createElement('div', { className: "grid grid-cols-2 gap-4" }, ENT_FIELDS.map(({ f, label }) => React.createElement(InputField, { key: f, label, val: (phases.entrenamiento?.[f] ?? DEFAULT_PARAMS.entrenamiento[f]), set: v => update('entrenamiento', f, v) })))
                    ),
                    React.createElement('div', { className: "glass-card p-6 space-y-4" },
                        React.createElement('span', { className: "font-black uppercase text-xs text-orange-500 border-b border-white/5 block pb-2" }, "Estiramientos"),
                        React.createElement('div', { className: "grid grid-cols-2 gap-4" }, STRETCH_FIELDS.map(({ f, label }) => React.createElement(InputField, { key: f, label, val: (phases.entrenamiento?.[f] ?? DEFAULT_PARAMS.entrenamiento[f]), set: v => update('entrenamiento', f, v) })))
                    )
                ),
                React.createElement('div', { className: "p-6 bg-slate-950 border-t border-white/5 shrink-0" },
                    React.createElement('button', { onClick: save, className: "w-full bg-white text-black py-6 rounded-full font-black uppercase", disabled: saving }, saving ? 'GUARDANDO...' : 'GUARDAR')
                )
            );
        }

        function InputField({ label, val, set }) {
            return React.createElement('div', { className: "flex flex-col items-center" },
                React.createElement('span', { className: "text-[8px] opacity-40 mb-2 uppercase" }, label),
                React.createElement('input', { type: "number", className: "w-full bg-slate-800/40 p-4 rounded-xl text-center font-black text-white border border-white/5 outline-none", value: val, onChange: e => set(e.target.value) })
            );
        }

        // ─── PlayerView ──────────────────────────────────────────────────────────────
        function PlayerView({ workout, onExit, onComplete }) {
            // ── UI state (solo para render) ──────────────────────────────────────────
            const [uiStatus, setUiStatus]     = useState('ready');  // 'ready'|'running'|'paused'|'finished'|'gps-running'
            const [uiIdx, setUiIdx]           = useState(0);
            const [uiTimeLeft, setUiTimeLeft] = useState(0);
            const [uiElapsed, setUiElapsed]   = useState(0);
            const [steps, setSteps]           = useState([]);

            // Post-workout mode selection states
            const [isModeSelectionScreenVisible, setIsModeSelectionScreenVisible] = useState(true); // Controls visibility of mode selection screen
            const [selectedWorkoutPhases, setSelectedWorkoutPhases]               = useState(null); // User's chosen workout structure (array of phase keys)
            const [isGpsActive, setIsGpsActive]           = useState(false); // If GPS tracker is currently running
            const [showGpsControls, setShowGpsControls]   = useState(false); // Controls visibility for GPS screen
            const [gpsData, setGpsData]                   = useState({ distance: 0, speed: 0, time: 0, pace: '0:00' });

            // ── Refs internos del timer (NO disparan re-render) ──────────────────────
            const statusRef       = useRef('ready');
            const idxRef          = useRef(0);
            const timeLeftRef     = useRef(0);
            const elapsedRef      = useRef(0);
            const stepsRef        = useRef([]);

            const stepDurRef      = useRef(0);     // duración del step actual
            const stepStartRef    = useRef(null);  // cuándo empezó el step actual (ms)
            const workoutStartRef = useRef(null);  // cuándo empezó el workout (ms, ajustado por pausa)
            const pausedAtRef     = useRef(null);  // cuándo se pausó (ms)

            const savedRef        = useRef(false);
            const spokenInit      = useRef({});
            const lastSpokenKey   = useRef('');
            const wakeLockRef     = useRef(null);
            const videoRef        = useRef(null);

            // GPS specific refs
            const gpsWatcherId            = useRef(null); // Geolocation watch ID
            const lastPosition            = useRef(null); // Last known GPS position
            const gpsStartTime            = useRef(null); // When GPS tracking actually started
            const gpsAnnounceLastTime     = useRef(0); // Timestamp of last voice announcement
            const gpsTotalDistance        = useRef(0); // Accumulated distance for the current segment
            const gpsTotalTime            = useRef(0); // Accumulated time for the current segment

            // ── Sincroniza refs de estado con state para uso en interval ────────────
            const setStatus = (s) => { statusRef.current = s; setUiStatus(s); };
            const setIdx    = (i) => { idxRef.current = i;    setUiIdx(i); };
            const setTime   = (t) => { timeLeftRef.current = t; setUiTimeLeft(t); };
            const setElap   = (e) => { elapsedRef.current = e; setUiElapsed(e); };

            // ── Finalizar workout ────────────────────────────────────────────────────
            const endWorkout = useCallback(() => {
                setStatus('finished');
                speak('Entrenamiento finalizado. ¡Buen trabajo!', true);
                if (!savedRef.current && workout) {
                    onComplete(workout.name, elapsedRef.current);
                    savedRef.current = true;
                }
            }, [workout, onComplete]);

            // ── Avanzar al siguiente step (lógica pura con refs) ─────────────────────
            const advanceToStep = useCallback((nextIdx) => {
                const s = stepsRef.current;
                if (nextIdx >= s.length) return false; // sin más steps
                idxRef.current   = nextIdx;
                stepDurRef.current = s[nextIdx].seconds;
                timeLeftRef.current = s[nextIdx].seconds;
                stepStartRef.current = Date.now();
                lastSpokenKey.current = '';
                spokenInit.current = {};
                setUiIdx(nextIdx);
                setUiTimeLeft(s[nextIdx].seconds);
                return true;
            }, []);

            // ── Saltar step ──────────────────────────────────────────────────────────
            const skipStep = useCallback(() => {
                if (statusRef.current === 'finished' || stepsRef.current.length === 0) return;
                const next = idxRef.current + 1;
                if (advanceToStep(next)) {
                    speak('Saltando. Siguiente.', true);
                    // Disparar speech inicial del siguiente step en el mismo tick
                    if (stepsRef.current[next].phase !== GPS_PHASE_KEY) {
                         handleSpeech(stepsRef.current[next], next, stepsRef.current[next].seconds);
                    }
                } else {
                    endWorkout();
                }
            }, [endWorkout, advanceToStep]);

            // ── GPS Tracking functions ───────────────────────────────────────────────
            const announceGpsStats = useCallback((distance, timeSec) => {
                const formattedDistance = formatDistance(distance);
                const formattedSpeed = formatSpeed(distance, timeSec);
                const formattedPace = formatPace(distance, timeSec);
                speak(`Distancia: ${formattedDistance}. Velocidad promedio: ${formattedSpeed}. Ritmo promedio: ${formattedPace}.`);
            }, []);

            const stopGpsTracking = useCallback(() => {
                if (gpsWatcherId.current) {
                    navigator.geolocation.clearWatch(gpsWatcherId.current);
                    gpsWatcherId.current = null;
                }
                if (gpsAnnounceIntervalRef.current) {
                    clearInterval(gpsAnnounceIntervalRef.current);
                    gpsAnnounceIntervalRef.current = null;
                }

                // Final announcement
                const finalDistance = gpsTotalDistance.current;
                const finalTime = gpsTotalTime.current;
                speak('Seguimiento de caminata o carrera finalizado. ', true, () => {
                    if (finalDistance > 0 && finalTime > 0) {
                        announceGpsStats(finalDistance, finalTime);
                    } else {
                        speak('No se registró distancia significativa.');
                    }
                    setIsGpsActive(false);
                    setShowGpsControls(false); // Reset controls visibility
                    setStatus('running'); // Return to normal running status
                    // After announcing, skip to the next step (which should be POST_GPS_REST)
                    skipStep();
                });
            }, [skipStep, announceGpsStats]);

            const startGpsTracking = useCallback(() => {
                if (!('geolocation' in navigator)) {
                    speak('Error: Geolocalización no disponible. No se puede iniciar el seguimiento.');
                    console.error("Geolocation is not supported by this browser.");
                    skipStep(); // Immediately skip this step if GPS not available
                    return;
                }
                if (isGpsActive) return; // Prevent multiple starts

                speak('Iniciando seguimiento de caminata o carrera. Las actualizaciones serán por audio cada diez minutos. Presiona el botón de encendido del celular para ver el botón de finalizar.', true);
                setIsGpsActive(true); // Indicate GPS is active for UI
                setStatus('gps-running'); // New status for GPS mode
                setShowGpsControls(false); // Initially hide controls

                gpsStartTime.current = Date.now();
                lastPosition.current = null;
                gpsTotalDistance.current = 0;
                gpsTotalTime.current = 0;
                setGpsData({ distance: 0, speed: 0, time: 0, pace: '0:00' }); // Reset GPS data visually (though not displayed)
                gpsAnnounceLastTime.current = gpsStartTime.current; // Initialize last announcement time

                const options = { enableHighAccuracy: true, timeout: 10000, maximumAge: 0 };

                gpsWatcherId.current = navigator.geolocation.watchPosition(
                    (position) => {
                        const { latitude, longitude } = position.coords;
                        const now = Date.now();
                        const timeElapsedMs = now - gpsStartTime.current;
                        const currentGpsTotalTime = Math.floor(timeElapsedMs / 1000); // Total time in seconds
                        gpsTotalTime.current = currentGpsTotalTime;

                        let currentDistance = gpsTotalDistance.current;
                        if (lastPosition.current) {
                            const dist = getDistance(
                                lastPosition.current.latitude,
                                lastPosition.current.longitude,
                                latitude,
                                longitude
                            );
                            currentDistance += dist;
                            gpsTotalDistance.current = currentDistance;
                        }
                        lastPosition.current = { latitude, longitude, timestamp: now };

                        // Calculate average speed for announcements
                        const averageSpeedKmH = (gpsTotalDistance.current > 0 && gpsTotalTime.current > 0)
                                                ? (gpsTotalDistance.current / gpsTotalTime.current) * 3.6
                                                : 0;

                        // Update state for internal tracking (not displayed) and potential final summary
                        setGpsData({
                            distance: gpsTotalDistance.current, // in meters
                            speed: averageSpeedKmH, // in km/h
                            time: currentGpsTotalTime, // in seconds
                            pace: formatPace(gpsTotalDistance.current, currentGpsTotalTime)
                        });

                        // Announce every 10 minutes (600 seconds)
                        if (currentGpsTotalTime > 0 && (now - gpsAnnounceLastTime.current) >= (10 * 60 * 1000)) {
                            announceGpsStats(gpsTotalDistance.current, currentGpsTotalTime);
                            gpsAnnounceLastTime.current = now;
                        }
                    },
                    (error) => {
                        console.error("GPS Error:", error);
                        speak(`Error de GPS: ${error.message}. Deteniendo seguimiento.`);
                        stopGpsTracking(); // Automatically stop on error
                    },
                    options
                );

                // Initial announcement after a brief moment to allow GPS to acquire fix
                setTimeout(() => {
                    if (statusRef.current === 'gps-running') { // Only announce if still active
                        speak('GPS activado. Iniciando seguimiento.');
                    }
                }, 5000); // Give GPS a few seconds to get first fix
            }, [skipStep, announceGpsStats, isGpsActive, stopGpsTracking]);


            // ── Toggle play/pause ────────────────────────────────────────────────────
            const togglePlay = useCallback(() => {
                if (!workout || stepsRef.current.length === 0) return;
                const current = statusRef.current;
                if (current === 'ready') {
                    // Primera vez: inicializar timestamps
                    const now = Date.now();
                    workoutStartRef.current = now;
                    stepStartRef.current    = now;
                    setStatus('running');
                } else if (current === 'running') {
                    // Pausar: guardar momento de pausa
                    pausedAtRef.current = Date.now();
                    setStatus('paused');
                } else if (current === 'paused') {
                    // Reanudar: ajustar timestamps por el tiempo pausado
                    const now = Date.Now();
                    const pausedMs = pausedAtRef.current ? now - pausedAtRef.current : 0;
                    if (workoutStartRef.current !== null) workoutStartRef.current += pausedMs;
                    if (stepStartRef.current    !== null) stepStartRef.current    += pausedMs;
                    pausedAtRef.current = null;
                    setStatus('running');
                }
            }, [workout]);

            // ── Inicialización cuando cambia workout o el modo de entrenamiento ────
            useEffect(() => {
                // Cancelar cualquier intervalo en curso limpiando status
                setStatus('ready');
                setIdx(0);
                setElap(0);
                savedRef.current = false;
                spokenInit.current = {};
                lastSpokenKey.current = '';
                workoutStartRef.current = null;
                stepStartRef.current = null;
                pausedAtRef.current = null;

                // Stop any GPS tracking if component re-initializes
                if (isGpsActive) stopGpsTracking(); // This will clear watchers, set isGpsActive to false

                // Only generate steps once selectedWorkoutPhases is decided AND mode selection is no longer visible
                if (isModeSelectionScreenVisible || !workout || !selectedWorkoutPhases) {
                    setSteps([]); // Clear steps while asking or if mode not set
                    return;
                }

                // Determine if GPS is part of the selected workout phases
                // This state is crucial for conditional rendering of GPS UI and wake lock logic
                const gpsIncluded = selectedWorkoutPhases.includes('run');
                setIsGpsActive(gpsIncluded); // Set initial state for GPS if 'run' phase is selected

                const generated = generateWorkoutSteps(workout, DEFAULT_PARAMS, selectedWorkoutPhases);
                stepsRef.current = generated;
                setSteps(generated);

                const firstSec = generated.length > 0 ? generated[0].seconds : 0;
                stepDurRef.current = firstSec;
                setTime(firstSec);
            }, [workout, isModeSelectionScreenVisible, selectedWorkoutPhases, stopGpsTracking, isGpsActive]); // Added isGpsActive dependency to ensure re-run if GPS status changes.

            // ── Wake lock ────────────────────────────────────────────────────────────
            const releaseWake = useCallback(() => {
                if (videoRef.current) videoRef.current.pause();
                if (wakeLockRef.current) { wakeLockRef.current.release(); wakeLockRef.current = null; }
            }, []);

            const requestWake = useCallback(async () => {
                try {
                    if (videoRef.current) videoRef.current.play().catch(() => {});
                    if ('wakeLock' in navigator && !wakeLockRef.current)
                        wakeLockRef.current = await navigator.wakeLock.request('screen');
                } catch (e) { console.warn("WakeLock:", e); e.message.includes("not allowed") && speak('Para el seguimiento GPS, mantén la pantalla encendida.'); }
            }, []);

            useEffect(() => {
                // Keep screen on during running or GPS tracking
                if (uiStatus === 'running' || uiStatus === 'gps-running') requestWake(); else releaseWake();
                return releaseWake;
            }, [uiStatus, requestWake, releaseWake]);

            // ── Visibility change ────────────────────────────────────────────────────
            useEffect(() => {
                const handleVisibilityChange = () => {
                    if (document.hidden) {
                        // Screen off / app moved to background
                        if (statusRef.current === 'running' || statusRef.current === 'gps-running') {
                            pausedAtRef.current = Date.now();
                            if (statusRef.current === 'running') setStatus('paused'); // Pause normal workout
                            // For GPS, we hide controls, but tracking continues in background (best effort)
                            setShowGpsControls(false); // Hide controls when screen is off
                        }
                        releaseWake();
                    } else {
                        // Screen on / app moved to foreground
                        if (statusRef.current === 'paused' && pausedAtRef.current !== null) {
                            const hiddenMs = Date.now() - pausedAtRef.current;
                            if (workoutStartRef.current !== null) workoutStartRef.current += hiddenMs;
                            if (stepStartRef.current    !== null) stepStartRef.current    += hiddenMs;
                            pausedAtRef.current = null;
                            setStatus('running');
                        } else if (statusRef.current === 'gps-running') {
                            setShowGpsControls(true); // Show controls when screen is on again
                        }
                        requestWake(); // Re-request wake lock
                    }
                };
                document.addEventListener('visibilitychange', handleVisibilityChange);
                return () => document.removeEventListener('visibilitychange', handleVisibilityChange);
            }, [requestWake, releaseWake]);


            // ── Speech helper (sin closures stale: recibe valores como params) ───────
            const handleSpeech = useCallback((step, stepIdx, remaining) => {
                if (statusRef.current !== 'running') return; // Only speak for standard running phase
                const initKey = `${stepIdx}_init`;
                if (remaining === step.seconds && step.voiceInitial && !spokenInit.current[initKey]) {
                    speak(step.voiceInitial, true);
                    if (step.whistleOnStart) whistle();
                    if ('vibrate' in navigator) navigator.vibrate(150);
                    spokenInit.current[initKey] = true;
                }
                if (step.voiceMidpoint && remaining === step.voiceMidpoint.time) {
                    const k = `${stepIdx}_mid_${remaining}`;
                    if (lastSpokenKey.current !== k) { speak(step.voiceMidpoint.text); lastSpokenKey.current = k; }
                }
                if (step.voiceCountdown && remaining > 0 && remaining <= 3) {
                    const k = `${stepIdx}_cd_${remaining}`;
                    if (lastSpokenKey.current !== k) { speak(String(remaining)); lastSpokenKey.current = k; }
                }
            }, []);

            // ── TIMER PRINCIPAL ──────────────────────────────────────────────────────
            useEffect(() => {
                if (uiStatus !== 'running' && uiStatus !== 'gps-running') return;

                const interval = setInterval(() => {
                    const now = Date.now();
                    const s = stepsRef.current;
                    const ci = idxRef.current;
                    const step = s[ci];

                    if (!step) {
                        endWorkout(); // No more steps
                        return;
                    }

                    // Always update total elapsed time
                    const totalElap = Math.floor((now - workoutStartRef.current) / 1000);
                    elapsedRef.current = totalElap;
                    setUiElapsed(totalElap);

                    // GPS tracking phase logic
                    if (step.phase === GPS_PHASE_KEY) {
                        if (!isGpsActive) { // isGpsActive state indicates if GPS watcher is actually running
                            startGpsTracking();
                        }
                        // If GPS is active, main timer for step progression is paused
                        return;
                    }

                    // If not in GPS phase, proceed with standard timer logic
                    if (statusRef.current !== 'running') return; // Ensure actual running state for normal steps

                    const passed   = Math.floor((now - stepStartRef.current) / 1000);
                    const remaining = Math.max(0, stepDurRef.current - passed);
                    timeLeftRef.current = remaining;
                    setUiTimeLeft(remaining);

                    handleSpeech(step, ci, remaining);

                    if (remaining === 0) {
                        // Step finished → advance
                        const next = ci + 1;
                        if (next < s.length) {
                            advanceToStep(next);
                            // Disparar speech inicial del siguiente step en el same tick if it's not GPS step
                            if (s[next].phase !== GPS_PHASE_KEY) {
                                handleSpeech(s[next], next, s[next].seconds);
                            }
                        } else {
                            endWorkout();
                        }
                    }
                }, 250);

                return () => clearInterval(interval);
            }, [uiStatus, workout, onComplete, handleSpeech, advanceToStep, isGpsActive, startGpsTracking, endWorkout]);


            // ── Render ───────────────────────────────────────────────────────────────
            if (!workout || (steps.length === 0 && uiStatus !== 'ready' && isModeSelectionScreenVisible))
                return React.createElement('div', { className: "h-screen flex items-center justify-center bg-slate-950 text-white/50 text-sm italic" }, "Cargando rutina...");

            // NEW: Render initial prompt for workout mode selection
            if (isModeSelectionScreenVisible) {
                return React.createElement(ModeSelectionScreen, {
                    onModeSelected: (phases) => {
                        setSelectedWorkoutPhases(phases); // Set the selected phases array
                        setIsModeSelectionScreenVisible(false); // Hide selection screen
                    },
                    onCancel: onExit // Go back to workouts screen
                });
            }

            // Render GPS tracking UI when active
            if (isGpsActive && uiStatus === 'gps-running') { // Only show GPS screen if GPS is active and uiStatus is gps-running
                return React.createElement('div', { className: "h-screen flex flex-col items-center justify-center bg-slate-950 text-white p-6" },
                    React.createElement('div', {
                        className: "absolute inset-0 bg-slate-950 flex flex-col items-center justify-center p-6",
                        // No specific click handler here, visibility is driven by actual screen state
                    },
                        // Content visible when controls are hidden (minimal display, "screen off")
                        !showGpsControls && React.createElement('div', { className: "text-center" },
                            React.createElement('h2', { className: "text-xl font-black uppercase text-slate-400 mb-2" }, "GPS ACTIVO"),
                            React.createElement('p', { className: "text-sm text-slate-600" }, "Presiona botón de encendido para controles")
                        ),

                        // Content visible when controls are shown (interactable display)
                        showGpsControls && React.createElement(React.Fragment, null,
                            React.createElement('h2', { className: "text-3xl font-black uppercase text-orange-500 mb-4" }, "Caminata / Carrera"),
                            React.createElement('p', { className: "text-lg text-slate-400 mb-10" }, "Seguimiento GPS Activo. Actualizaciones solo por voz."),

                            React.createElement('button', {
                                onClick: stopGpsTracking,
                                className: "w-full max-w-sm bg-red-600/80 text-white py-6 rounded-full font-black uppercase active:scale-95 italic"
                            }, "TERMINAR CAMINATA / CARRERA")
                        )
                    )
                );
            }


            if (uiStatus === 'finished')
                return React.createElement('div', { className: "h-screen flex flex-col items-center justify-center p-8 bg-slate-950 text-white text-center" },
                    React.createElement('h1', { className: "text-5xl font-black italic mb-4" }, "¡HECHO!"),
                    React.createElement('button', { onClick: onExit, className: "w-full max-w-sm bg-white text-black py-6 rounded-full font-black uppercase" }, "Finalizar")
                );

            const curr = steps[uiIdx] || steps[0];
            const showOverlay = uiStatus === 'ready' || uiStatus === 'paused';

            return React.createElement('div', { className: `h-screen flex flex-col transition-colors duration-700 ${curr?.color || 'bg-slate-950'} text-white` },
                React.createElement('video', { ref: videoRef, loop: true, muted: true, playsInline: true, style: { position: 'absolute', width: '1px', height: '1px', opacity: 0.01 } },
                    React.createElement('source', { src: "https://raw.githubusercontent.com/intel-iot-devkit/sample-videos/master/one-second-loop.mp4", type: "video/mp4" })
                ),

                // Header
                React.createElement('div', { className: "bg-black/10 p-4 pt-10 flex justify-between items-center shrink-0 z-10" },
                    React.createElement('div', { className: "leading-none text-left" },
                        React.createElement('span', { className: "text-[10px] font-black text-orange-500 uppercase" }, "Tiempo Total"),
                        React.createElement('p', { className: "text-xl font-black italic" }, formatTime(uiElapsed))
                    ),
                    React.createElement('div', { className: "text-center" },
                        React.createElement('h2', { className: "text-[10px] font-black uppercase italic truncate max-w-[120px] tracking-tight" }, workout?.name || 'Rutina')
                    ),
                    React.createElement('button', { onClick: onExit, className: "opacity-40 text-xl font-black px-2" }, "✕")
                ),

                // Centro: label + temporizador
                React.createElement('div', { className: "flex-1 flex flex-col items-center justify-center text-center px-4 min-h-0 relative" },
                    showOverlay && React.createElement('div', { className: "absolute inset-0 z-40 bg-slate-950/40 backdrop-blur-sm flex items-center justify-center" },
                        React.createElement('button', { onClick: togglePlay, className: "bg-orange-500 p-10 rounded-full shadow-2xl active:scale-90" },
                            React.createElement(IconPlay, null)
                        )
                    ),
                    React.createElement('h2', { className: "text-[11vw] font-black uppercase italic text-white/80 leading-none mb-2" }, curr?.label || 'LISTO'),
                    React.createElement('div', { className: "timer-huge tabular-nums text-white" }, uiTimeLeft)
                ),

                // Footer: controles
                React.createElement('div', { className: "bg-slate-950 p-6 pb-10 flex flex-col items-center shrink-0" },
                    React.createElement('div', { className: "w-full max-w-md grid grid-cols-3 items-center mb-6 text-center italic" },
                        React.createElement('button', { onClick: skipStep, className: "bg-slate-800/40 py-4 rounded-xl text-[10px] font-black uppercase text-white/70 active:scale-95" }, "Saltar"),
                        React.createElement('div', { className: "flex justify-center" },
                            uiStatus !== 'ready' && React.createElement('button', {
                                onClick: togglePlay,
                                className: "w-20 h-20 rounded-full border-4 border-yellow-400 flex items-center justify-center active:scale-90"
                            },
                                uiStatus === 'running' ? React.createElement(IconPause, null) : React.createElement(IconPlay, null)
                            )
                        ),
                        React.createElement('button', { onClick: endWorkout, className: "bg-red-500/20 py-4 rounded-xl text-[10px] font-black uppercase text-red-400 active:scale-95" }, "Finalizar")
                    ),
                    React.createElement('div', { className: "w-full max-w-md grid grid-cols-2 items-center text-center italic" },
                        React.createElement('div', { className: "flex flex-col" },
                            React.createElement('span', { className: "text-[14vw] font-black text-sky-400 leading-none" }, curr?.tr ? curr.tr - (curr.r || 0) + 1 : '-'),
                            React.createElement('span', { className: "text-[8px] opacity-40" }, "Rondas Restantes")
                        ),
                        React.createElement('div', { className: "flex flex-col" },
                            React.createElement('span', { className: "text-[14vw] font-black text-yellow-400 leading-none" }, curr?.tc ? curr.tc - (curr.cy || 0) + 1 : '-'),
                            React.createElement('span', { className: "text-[8px] opacity-40" }, "Ciclos Restantes")
                        )
                    )
                )
            );
        }

        // ─── AvanceView ──────────────────────────────────────────────────────────────
        function AvanceView({ history }) {
            const [periodType, setPeriodType] = useState('semana');
            const [periodOffset, setPeriodOffset] = useState(0);
            const chartRef = useRef(null);
            const chartInst = useRef(null);
            const PERIOD_TYPES = ['semana', 'mes', 'año'];

            // Helper para formatear tiempo en horas y minutos
            const formatTimeHnM = useCallback((seconds) => {
                const h = Math.floor(seconds / 3600);
                const m = Math.floor((seconds % 3600) / 60);
                return `${h}h ${m}m`;
            }, []);

            // Tiempo total acumulado (General)
            const totalSec = useMemo(() => history.reduce((a, h) => a + (h.totalTime || 0), 0), [history]);

            // Rango del período seleccionado actualmente (para el gráfico y resumen interactivo)
            const currentPeriodRange = useMemo(() => {
                const today = new Date();
                if (periodType === 'semana') return getWeekRange(today, periodOffset);
                if (periodType === 'mes')    return getMonthRange(today, periodOffset);
                if (periodType === 'año')    return getYearRange(today, periodOffset);
                return { start: new Date(0), end: new Date() }; // Fallback
            }, [periodType, periodOffset]);

            // Historial filtrado para el período seleccionado
            const filteredHistory = useMemo(() => history.filter(h => { const d = new Date(h.date); return d >= currentPeriodRange.start && d <= currentPeriodRange.end; }), [history, currentPeriodRange]);

            // Tiempo total del período seleccionado
            const periodSec = useMemo(() => filteredHistory.reduce((a, h) => a + (h.totalTime || 0), 0), [filteredHistory]);

            useEffect(() => {
                const ctx = chartRef.current?.getContext('2d');
                if (!ctx) return;
                if (chartInst.current) chartInst.current.destroy();
                let labels = [], data = [];
                const agg = new Map();

                if (periodType === 'semana') {
                    for (let d = new Date(currentPeriodRange.start); d <= currentPeriodRange.end; d.setDate(d.getDate() + 1))
                        labels.push(d.toLocaleDateString('es-ES', { weekday: 'short', day: 'numeric' }));
                    filteredHistory.forEach(h => { const k = new Date(h.date).toLocaleDateString('es-ES', { weekday: 'short', day: 'numeric' }); agg.set(k, (agg.get(k) || 0) + (h.totalTime || 0)); });
                    data = labels.map(l => Math.floor((agg.get(l) || 0) / 60));
                } else if (periodType === 'mes') {
                    // Adaptado para mostrar semanas dentro del mes, si el rango es un mes
                    let cur = startOfDay(new Date(currentPeriodRange.start));
                    // Ajustar al inicio de la primera semana visible para el mes, que puede empezar en el mes anterior
                    cur = startOfDay(new Date(cur.setDate(cur.getDate() - (cur.getDay() === 0 ? 6 : cur.getDay() - 1)))); // Lunes de la semana
                    let wn = 1;
                    while (cur <= currentPeriodRange.end) {
                        const ws = new Date(cur);
                        const we = endOfDay(new Date(cur.getFullYear(), cur.getMonth(), cur.getDate() + 6));

                        // Limitar la semana al rango del mes actual para el conteo de tiempo
                        const es = startOfDay(new Date(Math.max(ws.getTime(), currentPeriodRange.start.getTime())));
                        const ee = endOfDay(new Date(Math.min(we.getTime(), currentPeriodRange.end.getTime())));

                        if (es <= ee) {
                            labels.push(`Sem ${wn} (${es.getDate()}/${es.getMonth() + 1})`);
                            let wt = 0;
                            filteredHistory.forEach(h => { const d = new Date(h.date); if (d >= es && d <= ee) wt += (h.totalTime || 0); });
                            data.push(Math.floor(wt / 60));
                            wn++;
                        }
                        cur.setDate(cur.getDate() + 7); // Siguiente semana
                        if (cur > currentPeriodRange.end && cur.getMonth() !== currentPeriodRange.end.getMonth()) break; // If already out of month range
                    }
                } else { // periodType === 'año'
                    for (let i = 0; i < 12; i++) labels.push(new Date(currentPeriodRange.start.getFullYear(), i, 1).toLocaleDateString('es-ES', { month: 'short' }));
                    filteredHistory.forEach(h => { const k = new Date(h.date).toLocaleDateString('es-ES', { month: 'short' }); agg.set(k, (agg.get(k) || 0) + (h.totalTime || 0)); });
                    data = labels.map(l => Math.floor((agg.get(l) || 0) / 60));
                }

                chartInst.current = new Chart(ctx, {
                    type: 'bar',
                    data: { labels, datasets: [{ label: 'Minutos', data, backgroundColor: '#f97316', borderRadius: 8 }] },
                    options: { maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, grid: { color: 'rgba(255,255,255,0.05)' }, ticks: { color: '#64748b' } }, x: { grid: { display: false }, ticks: { color: '#64748b', font: { size: 10 } } } } }
                });
                return () => chartInst.current?.destroy();
            }, [filteredHistory, periodType, currentPeriodRange]);

            const periodTitle = useMemo(() => {
                const { start, end } = currentPeriodRange;
                const sf = { day: 'numeric', month: 'short' };
                if (periodType === 'semana') {
                    const cw = getWeekRange(new Date(), 0);
                    if (start.getTime() === cw.start.getTime()) return 'Semana Actual';
                    if (start.getTime() === getWeekRange(new Date(), -1).start.getTime()) return 'Semana Anterior';
                    return start.getMonth() === end.getMonth()
                        ? `Semana: ${start.getDate()} - ${end.toLocaleDateString('es-ES', { day: 'numeric' })}`
                        : `Semana: ${start.toLocaleDateString('es-ES', sf)} - ${end.toLocaleDateString('es-ES', sf)}`;
                }
                if (periodType === 'mes') {
                    if (start.getTime() === getMonthRange(new Date(), 0).start.getTime()) return 'Mes Actual';
                    if (start.getTime() === getMonthRange(new Date(), -1).start.getTime()) return 'Mes Anterior';
                    return `Mes: ${start.toLocaleDateString('es-ES', { month: 'long', year: 'numeric' })}`;
                }
                if (start.getTime() === getYearRange(new Date(), 0).start.getTime()) return 'Año Actual';
                if (start.getTime() === getYearRange(new Date(), -1).start.getTime()) return 'Año Anterior';
                return `Año: ${start.getFullYear()}`;
            }, [currentPeriodRange, periodType]);

            // Etiqueta para el resumen del período seleccionado (dinámico)
            const dynamicPeriodSummaryLabel = useMemo(() => {
                if (periodOffset !== 0) {
                    if (periodType === 'semana') return 'Tiempo en la semana seleccionada';
                    if (periodType === 'mes') return 'Tiempo en el mes seleccionado';
                    if (periodType === 'año') return 'Tiempo en el año seleccionado';
                }
                if (periodType === 'semana') return 'Tiempo en esta semana';
                if (periodType === 'mes')    return 'Tiempo en este mes';
                return 'Tiempo en este año';
            }, [periodOffset, periodType]);

            return React.createElement('div', { className: "flex-1 overflow-y-auto scrollbar-hide p-4 space-y-4 pb-28" },
                // Tarjeta de Tiempo Total Acumulado (General)
                React.createElement('div', { className: "glass-card p-6 text-center" },
                    React.createElement('span', { className: "text-[9px] opacity-40 block mb-1 uppercase" }, "Tiempo Total Acumulado"),
                    React.createElement('span', { className: "text-3xl font-black text-orange-500" }, formatTimeHnM(totalSec))
                ),

                // Selector de tipo de período (Semana, Mes, Año)
                React.createElement('div', { className: "flex gap-2" },
                    PERIOD_TYPES.map(p => React.createElement('button', { key: p, onClick: () => { setPeriodType(p); setPeriodOffset(0); }, className: `flex-1 py-3 rounded-xl font-black uppercase text-[10px] transition-all ${periodType === p ? 'bg-orange-500 text-white' : 'bg-white/5 text-slate-400'}` }, p))
                ),
                // Navegación de período y título
                React.createElement('div', { className: "flex items-center justify-between glass-card p-4" },
                    React.createElement('button', { onClick: () => setPeriodOffset(p => p - 1), className: "p-2 bg-white/5 text-slate-400 rounded-lg" },
                        React.createElement('svg', { width: "24", height: "24", viewBox: "0 0 24 24", fill: "currentColor" }, React.createElement('path', { d: "M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z" }))
                    ),
                    React.createElement('span', { className: "text-sm font-black uppercase italic text-orange-400" }, periodTitle),
                    React.createElement('button', { onClick: () => setPeriodOffset(p => p + 1), disabled: periodOffset >= 0, className: `p-2 rounded-lg ${periodOffset >= 0 ? 'bg-white/10 text-slate-600 cursor-not-allowed' : 'bg-white/5 text-slate-400'}` },
                        React.createElement('svg', { width: "24", height: "24", viewBox: "0 0 24 24", fill: "currentColor" }, React.createElement('path', { d: "M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z" }))
                    )
                ),
                // Resumen del período seleccionado (interactivo) - Esta es la tarjeta que cambia
                React.createElement('div', { className: "glass-card p-5 flex justify-between items-center" },
                    React.createElement('div', { className: "text-left" },
                        React.createElement('span', { className: "text-[9px] opacity-40 uppercase block" }, dynamicPeriodSummaryLabel),
                        React.createElement('span', { className: "text-2xl font-black text-sky-400" }, formatTimeHnM(periodSec))
                    ),
                    React.createElement('div', { className: "text-right" },
                        React.createElement('span', { className: "text-[9px] opacity-40 uppercase block" }, "Sesiones"),
                        React.createElement('span', { className: "text-2xl font-black text-emerald-400" }, filteredHistory.length)
                    )
                ),
                // Gráfico de avance
                React.createElement('div', { style: { height: '200px' } },
                        React.createElement('canvas', { ref: chartRef })
                    )
                )
            );
        }

        ReactDOM.createRoot(document.getElementById('root')).render(React.createElement(App, null));
    </script>
</body>
</html>