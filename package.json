{
  "name": "mi-entrenador-saludable",
  "version": "2.35.0",
  "description": "App Android hibrida para entrenamiento saludable con GPS.",
  "main": "www/index.html",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run test:coverage",
    "start": "npx cap serve",
    "android:add": "npx cap add android",
    "android:verify": "node scripts/android-safe.cjs verify",
    "android:release": "node scripts/android-safe.cjs release",
    "android:sync": "node scripts/android-safe.cjs sync",
    "android:open": "node scripts/android-safe.cjs open",
    "android:copy": "node scripts/android-safe.cjs copy"
  },
  "keywords": [
    "capacitor",
    "android",
    "gps",
    "fitness"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/geolocation": "^7.0.0",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor/local-notifications": "^7.0.0",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "vitest": "^4.1.10"
  }
}
